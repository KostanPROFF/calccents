{
  "name": "calccents",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/lib/calc/**/*.ts\" --test-coverage-exclude=\"src/lib/calc/**/*.test.ts\" --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 src/lib/calc/*.test.ts scripts/*.test.ts",
    "lint:advisory": "node scripts/lint-advisory.ts",
    "lint:links": "node scripts/check-links.ts",
    "lint:ads": "node scripts/check-ads.ts",
    "lint:ids": "node scripts/check-dom-ids.ts",
    "lint:consent": "node scripts/check-consent.ts",
    "lint": "pnpm lint:advisory && pnpm lint:links",
    "verify": "pnpm check && pnpm test && pnpm lint && pnpm build && pnpm lint:ads && pnpm lint:consent && pnpm lint:ids"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "typescript": "5.9.3",
    "wrangler": "4.151.3"
  }
}
