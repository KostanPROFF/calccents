# Public build-time variables. Copy to `.env` and fill in real values.
# Every variable here is embedded into the shipped HTML — never put a secret here.

# --- Site identity -------------------------------------------------------
# Canonical origin. Changing the domain means editing this file and
# src/config/site.ts (the single source of truth) — nothing else.
PUBLIC_SITE_ORIGIN=https://calccents.com

# --- Google AdSense ------------------------------------------------------
# Publisher ID, format ca-pub-XXXXXXXXXXXXXXXX. Leave empty until the
# AdSense account is approved: while it is empty the ad slots render as
# empty reserved space and no adsbygoogle markup is shipped at all.
PUBLIC_ADSENSE_CLIENT=

# Ad unit slot IDs. Create them in the AdSense dashboard after approval.
PUBLIC_ADSENSE_SLOT_RESULT=
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
PUBLIC_ADSENSE_SLOT_FOOTER=

# --- Analytics -----------------------------------------------------------
# Cloudflare Web Analytics needs no ID in the page: the script is injected
# by Cloudflare Pages itself. Use a token with write access to the Pages
# project to enable it.
#
# Google Analytics 4 is loaded on every page. The measurement ID lives in
# src/config/site.ts with the rest of the site identity; set this variable
# only to override it (a dummy ID in CI, for example).
PUBLIC_GA_ID=

# --- Newsletter ----------------------------------------------------------
# Buttondown form action URL, e.g. https://buttondown.email/api/emails/embed-subscribe/yourname
# Leave empty to hide the signup form entirely.
PUBLIC_BUTTONDOWN_FORM=

# --- Search Console ------------------------------------------------------
# The verification file is placed in public/ as google<id>.html
