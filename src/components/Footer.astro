---
import { getSite } from '../config/site.ts';
import { getUi } from '../i18n/ui/index.ts';
import { localePath, type Locale } from '../i18n/locales.ts';
import { TOOL_SLUGS } from '../config/tools.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
const ui = getUi(locale);

const calculators = TOOL_SLUGS.map((slug) => ({
  slug,
  label: ui.footer.calculators[slug],
}));

const siteLinks = site.footer.filter((item) => !item.href.startsWith('/tools/'));
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a class="brand" href={localePath(locale, '/')}>
          <span class="brand__mark" aria-hidden="true">C</span>
          <span class="brand__name">{site.name}</span>
        </a>
        <p class="text-sm text-muted" style="margin-top: var(--space-3); max-width: 34ch;">
          {site.tagline}. {ui.footer.taglineNote}
        </p>
      </div>
      <div>
        <h2>{ui.footer.calculatorsHeading}</h2>
        <ul>
          {
            calculators.map((item) => (
              <li>
                <a href={localePath(locale, `/tools/${item.slug}/`)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2>{ui.footer.siteHeading}</h2>
        <ul>
          {
            siteLinks.map((item) => (
              <li>
                <a href={localePath(locale, item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="site-footer__note">
      {
        /*
          The name is in the note twice, so every occurrence has to be
          replaced. A plain replace leaves the second one standing there as
          a literal {name}.
        */
        ui.footer.note
          .replaceAll('{name}', site.name)
          .replaceAll('{founded}', site.founded)
          .replaceAll('{year}', String(new Date().getFullYear()))
      }
    </p>
    {/*
      The LaunchNest listing badge, as LaunchNest gave it. The image is
      loaded lazily, so it costs nothing until the reader scrolls here.
    */}
    <a
      class="footer-badge"
      href="https://launchnest.io/p/calccents"
      target="_blank"
      rel="noopener"
    >
      <img
        src="https://launchnest.io/badge/calccents.svg?variant=featured"
        alt="Calccents on LaunchNest"
        width="220"
        height="56"
        loading="lazy"
      />
    </a>
    {/*
      The BuiltByIndies listing badge, as BuiltByIndies gave it. It has to be
      in the page's HTML itself: BuiltByIndies checks the home page for it.
    */}
    <a
      class="footer-badge"
      href="https://builtbyindies.com/products/calccents?utm_source=badge&utm_medium=embed&utm_campaign=live"
      target="_blank"
      rel="noopener"
    >
      <img
        src="https://builtbyindies.com/badge/ab73bec0-6e79-4609-8d28-d2304e520488.svg?theme=dark"
        alt="BuiltByIndies"
        height="60"
        loading="lazy"
      />
    </a>
    {/*
      The cookie question has to be answerable more than once. The button
      reopens Google's consent message, and stays hidden for a reader the
      message does not apply to: the consent component shows it.
    */}
    <button type="button" class="footer-consent" data-consent-open hidden>
      {ui.footer.cookieSettings}
    </button>
  </div>
</footer>

<style>
  .footer-badge {
    display: inline-block;
    margin-top: var(--space-3);
    margin-right: var(--space-3);
    vertical-align: middle;
  }

  .footer-badge img {
    display: block;
  }

  .footer-consent {
    margin-top: var(--space-3);
    padding: 0;
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-family: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .footer-consent:hover {
    color: var(--text-secondary);
  }
</style>
