---
/**
 * The block that says what a tool does not do.
 *
 * It is the structural guardrail against the site drifting into giving
 * advice: every tool states its limits in the same place, in the same
 * words, right under the result.
 */
import { getUi } from '../i18n/ui/index.ts';
import type { Locale } from '../i18n/locales.ts';

interface Props {
  items: string[];
  locale: Locale;
  title?: string;
}

const { items, locale, title } = Astro.props;
const ui = getUi(locale);
---

<div class="note note--warning">
  <p class="note__title">{title ?? ui.ui.whatThisCalculatorDoesNotDo}</p>
  <ul>
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>
