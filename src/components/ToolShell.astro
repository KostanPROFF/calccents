---
/**
 * The frame every calculator page shares: breadcrumb, heading, the two
 * column calculator area, the method, the limits, the sources and the FAQ.
 * A tool that does not use this shell does not match the site's structure.
 *
 * The shell picks the calculator component itself rather than taking it as a
 * slot. Astro drops a child that carries a `slot` attribute the parent does
 * not define, so nesting a calculator that fills its own named slots inside
 * another component silently loses the form and the result panel. Letting
 * the shell own the choice keeps the calculator a plain component with two
 * root elements: the form and the result panel, which are the two columns
 * of the layout.
 */
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import AdAdvice from './AdAdvice.astro';
import SourceList from './SourceList.astro';
import Faq from './Faq.astro';
import MortgageCalculator from './tools/MortgageCalculator.astro';
import NetPayCalculator from './tools/NetPayCalculator.astro';
import IncomeTaxCalculator from './tools/IncomeTaxCalculator.astro';
import DebtPayoffCalculator from './tools/DebtPayoffCalculator.astro';
import RentVsBuyCalculator from './tools/RentVsBuyCalculator.astro';
import CompoundInterestCalculator from './tools/CompoundInterestCalculator.astro';
import { getSite } from '../config/site.ts';
import { getTool, type ToolSlug } from '../config/tools.ts';
import { getUi } from '../i18n/ui/index.ts';
import { formatDate, localePath, type Locale } from '../i18n/locales.ts';
import { getGuides, guideSlug } from '../i18n/guides.ts';

interface Props {
  slug: ToolSlug;
  locale: Locale;
}

const { slug, locale } = Astro.props;

const site = getSite(locale);
const ui = getUi(locale);
const tool = getTool(slug, locale);
const copy = ui.tool[slug];
const reviewedOn = formatDate(tool.reviewedOn, locale);

const CALCULATORS = {
  'mortgage-payment': MortgageCalculator,
  'rent-vs-buy': RentVsBuyCalculator,
  'compound-interest': CompoundInterestCalculator,
  'net-pay': NetPayCalculator,
  'income-tax': IncomeTaxCalculator,
  'debt-payoff': DebtPayoffCalculator,
} as const;

/**
 * Where the formula sits in the method paragraphs.
 *
 * The formula is one line of algebra and it reads best next to the
 * paragraph it comes from, which is not the same place in every tool.
 * The default is after the first paragraph.
 */
const FORMULA_AFTER: Partial<Record<ToolSlug, number>> = {
  'rent-vs-buy': 1,
  'compound-interest': 1,
  'debt-payoff': 1,
};

const Calculator = CALCULATORS[slug];

/**
 * The related guides, named in the language the page is in.
 *
 * The title comes from the guide itself when the guide exists in this
 * language. Otherwise the dictionary's title is used, so a page in a
 * language that is not finished yet still links somewhere sensible.
 */
const guides = await getGuides(locale);
const bySlug = new Map(guides.map((guide) => [guideSlug(guide.id), guide]));
const relatedGuides = copy.relatedGuides.map((entry) => ({
  slug: entry.slug,
  title: bySlug.get(entry.slug)?.data.title ?? entry.title,
}));

const path = localePath(locale, `/tools/${slug}/`);

const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  description: tool.description,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  url: new URL(path, site.origin).toString(),
  isAccessibleForFree: true,
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.origin,
  },
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base
  title={tool.title}
  description={tool.description}
  path={path}
  locale={locale}
  jsonLd={[softwareApplication, faqPage]}
>
  <div class="container">
    <div class="page-head">
      <nav class="breadcrumb" aria-label={ui.ui.breadcrumb}>
        <a href={localePath(locale, '/')}>{ui.ui.home}</a>
        <span aria-hidden="true">/</span>
        <a href={localePath(locale, '/tools/')}>{ui.nav.tools}</a>
        <span aria-hidden="true">/</span>
        <span>{tool.name}</span>
      </nav>
      <h1>{tool.title}</h1>
      <p class="page-head__lede">{tool.description}</p>
      <div class="reviewed-line" style="margin-top: var(--space-5);">
        <span>{ui.ui.lastChecked}: {reviewedOn}</span>
        <span aria-hidden="true">·</span>
        <span>
          {ui.ui.by} <a href={localePath(locale, '/editorial-team/')}>{site.author.name}</a>
        </span>
        <span aria-hidden="true">·</span>
        <a href={localePath(locale, '/sources/')}>{ui.ui.whereNumbersComeFrom}</a>
      </div>
    </div>

    <div class="tool-layout">
      <Calculator locale={locale} />
    </div>

    <section class="section-sm">
      <h2>{ui.ui.howThisIsCalculated}</h2>
      {copy.methodNote && <p class="text-muted">{copy.methodNote}</p>}
      <div class="prose" style="margin-top: var(--space-4);">
        {
          copy.method.map((paragraph, index) => (
            <Fragment>
              <p>{paragraph}</p>
              {FORMULA_AFTER[slug] === index && (
                <p class="formula-callout">
                  <strong>{copy.formula}</strong>
                </p>
              )}
            </Fragment>
          ))
        }
      </div>
    </section>

    <AdAdvice items={copy.limits} locale={locale} />

    <AdSlot placement="in-article" />

    <SourceList sources={copy.sources} locale={locale} />

    {
      relatedGuides.length > 0 && (
        <section class="section-sm">
          <h2>{ui.ui.guidesThatGoDeeper}</h2>
          <div class="grid grid--2" style="margin-top: var(--space-5);">
            {relatedGuides.map((guide) => (
              <a class="tile" href={localePath(locale, `/guides/${guide.slug}/`)}>
                <span class="tile__title">{guide.title}</span>
                <span class="tile__meta">{ui.ui.readTheGuide}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="section-sm">
      <h2>{ui.ui.commonQuestions}</h2>
      <div style="margin-top: var(--space-5);">
        <Faq items={copy.faq} />
      </div>
    </section>

    <AdSlot placement="footer" />
  </div>
</Base>
