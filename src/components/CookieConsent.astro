---
/**
 * Consent, advertising and analytics.
 *
 * The consent question is asked by Google, not by this site. The AdSense
 * account publishes Google's own consent message (AdSense, "Privacy &
 * messaging", "European regulations"), which is a certified consent
 * platform under the IAB's framework. Google shows it only to readers in
 * the countries that require it: the European Economic Area, the United
 * Kingdom and Switzerland. Everyone else sees no question at all.
 *
 * What runs, and when:
 *
 *   AdSense       loaded on every page. In the countries above it waits for
 *                 the answer to Google's message and serves ads accordingly.
 *   Analytics     Google Analytics in consent mode. In the countries above
 *                 it starts with storage denied, sets no cookie and sends
 *                 only cookieless pings until the message is answered; the
 *                 message updates the consent state itself. Everywhere else
 *                 it starts with storage granted.
 *   Cloudflare    the hosting provider's beacon sets no cookie and stores
 *                 nothing, so it needs no consent. It is still left out for
 *                 a reader in the European Union, as the privacy policy
 *                 promises.
 *
 * The footer carries a "Cookie settings" button that reopens Google's
 * message. It is hidden until the message reports that the consent rules
 * apply to this reader, since outside those countries there is nothing to
 * reopen.
 *
 * Cloudflare can add a beacon of its own to every page it serves. The
 * automatic setup in the Cloudflare dashboard is switched off, and the
 * bootstrap takes that beacon out of the document anyway, so that a page
 * view is never counted twice and a reader in the EU is never counted.
 */
import { SITE } from '../config/site.ts';
import { CONSENT_COUNTRIES, EU_COUNTRIES } from '../lib/data/euCountries.ts';

const gaId = import.meta.env.PUBLIC_GA_ID || SITE.gaMeasurementId;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || SITE.adsensePublisherId;
const cloudflareToken =
  import.meta.env.PUBLIC_CLOUDFLARE_BEACON_TOKEN || SITE.cloudflareBeaconToken;
const gaUrl = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
const analyticsHost = new URL(SITE.origin).hostname;
const adsenseUrl = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`;
const cloudflareUrl = 'https://static.cloudflareinsights.com/beacon.min.js';

/**
 * How long Google Analytics waits for the consent message to report a
 * stored answer before it sends the first ping, in milliseconds.
 */
const CONSENT_WAIT_MS = 500;

/**
 * The bootstrap.
 *
 * It is written as plain ES5 in a string, because it has to run before any
 * other script on the page and it has to survive being inlined into the
 * HTML. It runs before the AdSense loader below, so the consent defaults
 * are in place before any Google tag reads them.
 */
const bootstrap = `(function () {
  var GA_ID = '${gaId}';
  var GA_URL = '${gaUrl}';
  var ANALYTICS_HOST = '${analyticsHost}';
  var CLOUDFLARE_URL = '${cloudflareUrl}';
  var CLOUDFLARE_TOKEN = '${cloudflareToken}';
  var BEACON_HOST = 'static.cloudflareinsights.com';
  var EU_COUNTRIES = ${JSON.stringify(EU_COUNTRIES)};
  var CONSENT_COUNTRIES = ${JSON.stringify(CONSENT_COUNTRIES)};
  var CONSENT_WAIT_MS = ${CONSENT_WAIT_MS};
  var REGION_URL = '/api/region';
  var REGION_KEY = 'cc-region';
  var CONSENT_TYPES = ['ad_storage', 'ad_user_data', 'ad_personalization', 'analytics_storage'];
  var beaconObserver = null;

  suppressInjectedBeacon();
  startAnalytics();
  pushAdUnits();
  loadHostingAnalyticsWhenKnown();
  showSettingsWhenConsentApplies();

  function consentState(value) {
    var state = {};
    for (var i = 0; i < CONSENT_TYPES.length; i += 1) { state[CONSENT_TYPES[i]] = value; }
    return state;
  }

  /*
   * Google Analytics, in consent mode.
   *
   * Storage is denied by default in the countries where a reader has to
   * agree first, and granted everywhere else. Google's consent message
   * updates the state when the reader answers, or on the next page when the
   * answer is already stored.
   *
   * It only runs on the production host. A copy of the site running on a
   * developer's machine would otherwise report its page views into the same
   * property, and those visits would be counted as readers.
   */
  function startAnalytics() {
    var host = window.location.hostname;
    if (host !== ANALYTICS_HOST && host !== 'www.' + ANALYTICS_HOST) return;
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = gtag;
    var denied = consentState('denied');
    denied.region = CONSENT_COUNTRIES;
    denied.wait_for_update = CONSENT_WAIT_MS;
    gtag('consent', 'default', denied);
    gtag('consent', 'default', consentState('granted'));
    gtag('js', new Date());
    gtag('config', GA_ID);
    var el = document.createElement('script');
    el.async = true;
    el.src = GA_URL;
    document.head.appendChild(el);
  }

  // The hand-placed units are queued now and filled once the loader below
  // has arrived.
  function pushAdUnits() {
    window.adsbygoogle = window.adsbygoogle || [];
    var units = document.querySelectorAll('ins.adsbygoogle');
    for (var i = 0; i < units.length; i += 1) {
      window.adsbygoogle.push({});
    }
  }

  /*
   * The footer button that reopens Google's consent message.
   *
   * Google's message reports, once it is ready, whether the consent rules
   * apply to this reader. The button is shown only when they do.
   */
  function showSettingsWhenConsentApplies() {
    window.googlefc = window.googlefc || {};
    window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
    window.googlefc.callbackQueue.push({
      CONSENT_DATA_READY: function () {
        if (typeof window.__tcfapi !== 'function') return;
        window.__tcfapi('getTCData', 2, function (data, success) {
          if (!success || !data || !data.gdprApplies) return;
          var buttons = document.querySelectorAll('[data-consent-open]');
          for (var i = 0; i < buttons.length; i += 1) { buttons[i].hidden = false; }
        });
      },
    });

    document.addEventListener('click', function (event) {
      var target = event.target;
      if (!target || !target.closest || !target.closest('[data-consent-open]')) return;
      event.preventDefault();
      window.googlefc.callbackQueue.push(function () {
        window.googlefc.showRevocationMessage();
      });
    });
  }

  /*
   * Cloudflare's own page analytics.
   *
   * The configuration is the one Cloudflare's dashboard hands out for a
   * manual installation: the site token and nothing else. It must not carry
   * the "version" field, which points the beacon at the site's own
   * /cdn-cgi/rum endpoint, and that endpoint answers 404 while the automatic
   * setup is off.
   */
  function loadHostingAnalytics() {
    if (beaconObserver) {
      beaconObserver.disconnect();
      beaconObserver = null;
    }
    var el = document.createElement('script');
    el.defer = true;
    el.src = CLOUDFLARE_URL;
    el.setAttribute('data-cf-beacon', JSON.stringify({
      token: CLOUDFLARE_TOKEN,
    }));
    document.head.appendChild(el);
  }

  /*
   * The country of the reader, asked of this site rather than of a third
   * party, and kept for the session so it is asked once. A reader in the
   * European Union is not counted by the hosting provider at all.
   */
  function readCountry() {
    try {
      var cached = window.sessionStorage.getItem(REGION_KEY);
      if (cached) { return Promise.resolve(cached); }
    } catch (error) { /* private mode */ }

    return fetch(REGION_URL, { headers: { accept: 'application/json' } })
      .then(function (response) { return response.json(); })
      .then(function (data) {
        var country = data && data.country ? String(data.country).toUpperCase() : '';
        try {
          window.sessionStorage.setItem(REGION_KEY, country);
        } catch (error) { /* private mode */ }
        return country;
      });
  }

  function loadHostingAnalyticsWhenKnown() {
    if (typeof window.fetch !== 'function' || typeof window.Promise !== 'function') return;
    readCountry().then(function (country) {
      if (country && EU_COUNTRIES.indexOf(country) !== -1) { return; }
      loadHostingAnalytics();
    }).catch(function () {
      // The country could not be read, so it could be a reader in the EU:
      // the beacon stays off.
    });
  }

  /*
   * The beacon Cloudflare adds by itself, taken out of the document before
   * it can run. The automatic setup is switched off, so there is nothing to
   * take out at the moment; this is a net for the day it is switched back on.
   */
  function suppressInjectedBeacon() {
    if (typeof MutationObserver !== 'function') return;
    beaconObserver = new MutationObserver(function (records) {
      for (var i = 0; i < records.length; i += 1) {
        var added = records[i].addedNodes;
        for (var j = 0; j < added.length; j += 1) {
          var node = added[j];
          if (!node || node.tagName !== 'SCRIPT') continue;
          if (!node.src || node.src.indexOf(BEACON_HOST) === -1) continue;
          if (node.parentNode) node.parentNode.removeChild(node);
        }
      }
    });
    beaconObserver.observe(document.documentElement, { childList: true, subtree: true });

    var injected = document.querySelectorAll('script[src*="' + BEACON_HOST + '"]');
    for (var k = 0; k < injected.length; k += 1) {
      if (injected[k].parentNode) injected[k].parentNode.removeChild(injected[k]);
    }
  }
})();`;
---

<script is:inline set:html={bootstrap} />
<script is:inline async src={adsenseUrl} crossorigin="anonymous"></script>
