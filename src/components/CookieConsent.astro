---
/**
 * Cookie consent.
 *
 * The site loads four things once the reader has answered: the AdSense
 * script from Google, which serves the advertising, the Google Analytics
 * script, which counts the page views, the Google Tag Manager container,
 * which holds the tags the site fires, and the Cloudflare beacon, which
 * measures how fast the pages load. The first three set cookies. The last
 * one sets none, but it is still a request to a third party, so it waits
 * for the answer as well.
 *
 * Cloudflare can add a beacon of its own to every page it serves, and that
 * one reports the page view before anyone has answered anything. The
 * automatic setup in the Cloudflare dashboard is switched off, so nothing is
 * added in the first place, and the bootstrap takes the beacon out of the
 * document anyway, as a net for the day the setup is switched back on. The
 * site's own copy takes its place after the answer.
 *
 * The script tags are not in the document. They are injected by the
 * bootstrap below once the answer is known, which is why the source of a
 * page contains the URLs but no request goes out before the answer.
 *
 * The three states:
 *
 *   no answer   the banner is shown, the ad units stay hidden and no
 *               request leaves the browser
 *   accepted   all four scripts are loaded, the ad units are pushed to
 *               Google
 *   declined   nothing is loaded, the ad units are removed from the page
 *
 * A reader in the European Union is an exception to the middle one: the
 * hosting provider's beacon is not loaded for them at all, so that provider
 * counts no page view of theirs. The country comes from the network the
 * site is served from, the same place the calculators ask for the state, and
 * the question goes to this site rather than to a third party.
 *
 * The banner can be opened again from the footer, so a reader who changes
 * their mind is not stuck with the first answer.
 *
 * There is one exception, and it is not a reader. Google's crawler renders
 * the page when it reviews the site for advertising, and it cannot answer a
 * cookie question: no banner, no click, no consent. A site whose advertising
 * only loads after a click is therefore a site that shows the reviewer no
 * advertising at all, which is the commonest reason an application is turned
 * down. So a recognised crawler is given the ad script directly, without the
 * banner and without the analytics. It is not a person, no consent is
 * recorded for it and nothing about it is stored.
 */
import { SITE } from '../config/site.ts';
import { getUi } from '../i18n/ui/index.ts';
import { localePath, type Locale } from '../i18n/locales.ts';
import { EU_COUNTRIES } from '../lib/data/euCountries.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const copy = ui.consent;

const gaId = import.meta.env.PUBLIC_GA_ID || SITE.gaMeasurementId;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || SITE.adsensePublisherId;
const cloudflareToken =
  import.meta.env.PUBLIC_CLOUDFLARE_BEACON_TOKEN || SITE.cloudflareBeaconToken;
const gtmId = import.meta.env.PUBLIC_GTM_ID || SITE.gtmId;

const gaUrl = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
const gtmUrl = `https://www.googletagmanager.com/gtm.js?id=${gtmId}`;
const adsenseUrl = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`;
const cloudflareUrl = 'https://static.cloudflareinsights.com/beacon.min.js';

const privacyLink = `<a href="${localePath(locale, '/privacy/')}">${copy.privacyLink}</a>`;
const body = copy.body.replace('{privacyLink}', privacyLink);

/**
 * The bootstrap.
 *
 * It is written as plain ES5 in a string, because it has to run before any
 * module on the page and it has to survive being inlined into the HTML.
 * The two URLs are interpolated rather than read from the DOM, so the
 * publisher IDs are in the markup for the ad check to read.
 */
const bootstrap = `(function () {
  var KEY = 'cc-consent';
  var GA_ID = '${gaId}';
  var GA_URL = '${gaUrl}';
  var ADSENSE_URL = '${adsenseUrl}';
  var GTM_URL = '${gtmUrl}';
  var CLOUDFLARE_URL = '${cloudflareUrl}';
  var CLOUDFLARE_TOKEN = '${cloudflareToken}';
  var BEACON_HOST = 'static.cloudflareinsights.com';
  var EU_COUNTRIES = ${JSON.stringify(EU_COUNTRIES)};
  var REGION_URL = '/api/region';
  var REGION_KEY = 'cc-region';
  var beaconObserver = null;

  // The beacon Cloudflare adds by itself is taken out of the document
  // before it can report anything.
  suppressInjectedBeacon();

  function read() {
    try { return window.localStorage.getItem(KEY); } catch (error) { return null; }
  }
  function write(value) {
    try { window.localStorage.setItem(KEY, value); } catch (error) { /* private mode */ }
  }

  function loadAnalytics() {
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', GA_ID);
    var el = document.createElement('script');
    el.async = true;
    el.src = GA_URL;
    document.head.appendChild(el);
  }

  /*
   * The tag manager.
   *
   * The container holds the tags the site fires, so a tag can be added or
   * changed without a new build of the site. It is a Google script that
   * sets cookies, so it waits for the answer like the other two.
   *
   * The container is not in the document: it is injected here, after the
   * answer, which is why the source of a page carries the URL and no
   * request goes out before the answer.
   *
   * The noscript frame that Google's own installation snippet carries is
   * left out on purpose. It would load the container for a reader whose
   * browser has no JavaScript, and that reader has no way to answer the
   * cookie question, so the request would go out with no consent behind it.
   */
  function loadTagManager() {
    window.dataLayer = window.dataLayer || [];
    /*
     * The container reads the queue it finds on the page. The gtag shim is
     * what the tags in it call, and the gtm.start event is what tells the
     * container when the page began, so that a page view is timed from the
     * start of the page rather than from the moment the answer was given.
     */
    if (typeof window.gtag !== 'function') {
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
    }
    window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
    var el = document.createElement('script');
    el.async = true;
    el.src = GTM_URL;
    document.head.appendChild(el);
  }

  function loadAds() {
    var el = document.createElement('script');
    el.async = true;
    el.src = ADSENSE_URL;
    // The hand-placed units are only known to Google once the loader has
    // arrived, so the push happens after it loads.
    el.onload = function () {
      window.adsbygoogle = window.adsbygoogle || [];
      var units = document.querySelectorAll('ins.adsbygoogle');
      for (var i = 0; i < units.length; i += 1) {
        window.adsbygoogle.push({});
      }
    };
    document.head.appendChild(el);
  }

  function loadHostingAnalytics() {
    /*
     * Cloudflare's own page analytics.
     *
     * The configuration is the one Cloudflare's own dashboard hands out for
     * a manual installation: the site token and nothing else. The beacon
     * reports the page view to Cloudflare's analytics service at
     * cloudflareinsights.com, which answers with the CORS headers this
     * domain needs.
     *
     * The configuration must not carry the "version" field. That field
     * points the beacon at the site's own /cdn-cgi/rum endpoint instead,
     * and that endpoint answers 404 while the automatic setup in the
     * dashboard is off, so the page view would be counted nowhere.
     *
     * The script sets no cookie and stores nothing, so it only counts page
     * views and how fast the pages load.
     */
    if (beaconObserver) {
      beaconObserver.disconnect();
      beaconObserver = null;
    }
    var el = document.createElement('script');
    el.defer = true;
    el.src = CLOUDFLARE_URL;
    el.setAttribute('data-cf-beacon', JSON.stringify({
      token: CLOUDFLARE_TOKEN,
    }));
    document.head.appendChild(el);
  }

  /*
   * The country of the reader.
   *
   * The hosting provider's own dashboard can be told not to count visitors
   * from the European Union, but that setting only covers the beacon the
   * edge adds to every page it serves. This site loads the beacon itself,
   * after the answer, so the country is asked for here and the beacon is
   * left out for a reader in the EU.
   *
   * The answer is kept for the session, so it is asked for once. Nothing
   * leaves the browser: the question goes to this site, and the country
   * comes back from the network the site is served from.
   */
  function readCountry() {
    try {
      var cached = window.sessionStorage.getItem(REGION_KEY);
      if (cached) { return Promise.resolve(cached); }
    } catch (error) { /* private mode */ }

    return fetch(REGION_URL, { headers: { accept: 'application/json' } })
      .then(function (response) { return response.json(); })
      .then(function (data) {
        var country = data && data.country ? String(data.country).toUpperCase() : '';
        try {
          window.sessionStorage.setItem(REGION_KEY, country);
        } catch (error) { /* private mode */ }
        return country;
      });
  }

  function loadHostingAnalyticsWhenKnown() {
    if (typeof window.fetch !== 'function' || typeof window.Promise !== 'function') {
      loadHostingAnalytics();
      return;
    }
    readCountry().then(function (country) {
      // A reader in the European Union is not counted at all.
      if (country && EU_COUNTRIES.indexOf(country) !== -1) { return; }
      loadHostingAnalytics();
    }).catch(function () {
      // The country could not be read. The reader answered the question, so
      // the beacon is loaded as it was before.
      loadHostingAnalytics();
    });
  }

  /*
   * The beacon Cloudflare adds by itself.
   *
   * Cloudflare adds a beacon to every page it serves, unless the automatic
   * setup is switched off in the Cloudflare dashboard. That beacon reports
   * the page view straight away, before the reader has answered the cookie
   * question, so it is taken out of the document before it can run: a
   * script that is removed before it runs does not run.
   *
   * The automatic setup is switched off, so there is nothing to take out at
   * the moment. The code stays as a net for the day it is switched back on.
   *
   * The tag may already be in the document when this runs, or it may still
   * arrive later, so both are covered. The site's own copy is loaded after
   * the answer, with the same site token.
   */
  function suppressInjectedBeacon() {
    if (typeof MutationObserver !== 'function') return;
    beaconObserver = new MutationObserver(function (records) {
      for (var i = 0; i < records.length; i += 1) {
        var added = records[i].addedNodes;
        for (var j = 0; j < added.length; j += 1) {
          var node = added[j];
          if (!node || node.tagName !== 'SCRIPT') continue;
          if (!node.src || node.src.indexOf(BEACON_HOST) === -1) continue;
          if (node.parentNode) node.parentNode.removeChild(node);
        }
      }
    });
    beaconObserver.observe(document.documentElement, { childList: true, subtree: true });

    var injected = document.querySelectorAll('script[src*="' + BEACON_HOST + '"]');
    for (var k = 0; k < injected.length; k += 1) {
      if (injected[k].parentNode) injected[k].parentNode.removeChild(injected[k]);
    }
  }

  function removeAdUnits() {
    var units = document.querySelectorAll('ins.adsbygoogle');
    for (var i = 0; i < units.length; i += 1) {
      units[i].parentNode.removeChild(units[i]);
    }
  }

  function grant() {
    document.documentElement.classList.add('consent-granted');
    loadAnalytics();
    loadTagManager();
    loadAds();
    loadHostingAnalyticsWhenKnown();
  }

  function deny() {
    document.documentElement.classList.remove('consent-granted');
    removeAdUnits();
  }

  var banner = document.getElementById('consent-banner');
  var decision = read();

  /*
   * Google's own crawler.
   *
   * The reviewer that checks the site for advertising renders the page with
   * a crawler user agent. It does not answer the cookie question, so the
   * advertising script would never load for it and the site would be
   * reviewed as a site with no advertising on it. The crawler is therefore
   * given the ad script straight away. Neither of the two analytics are
   * loaded for it: a page view counted from a crawler is noise, not a
   * reader.
   */
  function isCrawler() {
    return /bot|crawler|spider|slurp|mediapartners/i.test(navigator.userAgent || '');
  }

  if (isCrawler()) {
    document.documentElement.classList.add('consent-granted');
    if (banner) { banner.hidden = true; }
    loadAds();
  } else if (decision === 'granted') {
    grant();
  } else if (decision === 'denied') {
    deny();
  } else {
    // No answer yet: the ad units stay hidden by the stylesheet and the
    // banner asks.
    if (banner) {
      banner.hidden = false;
      banner.focus();
    }
  }

  function answer(value) {
    var previous = read();
    write(value);
    if (banner) banner.hidden = true;
    if (previous && previous !== value) {
      // A changed answer can only take effect on a fresh page: a script
      // that has already run cannot be unloaded.
      window.location.reload();
      return;
    }
    if (value === 'granted') { grant(); } else { deny(); }
  }

  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!target || !target.closest) return;

    var choice = target.closest('[data-consent]');
    if (choice) {
      answer(choice.getAttribute('data-consent'));
      return;
    }

    var reopen = target.closest('[data-consent-open]');
    if (reopen && banner) {
      event.preventDefault();
      banner.hidden = false;
      banner.focus();
    }
  });
})();`;
---

<div
  class="consent"
  id="consent-banner"
  role="dialog"
  aria-labelledby="consent-heading"
  tabindex="-1"
  hidden
>
  <div class="consent__inner">
    <div class="consent__text">
      <h2 class="consent__heading" id="consent-heading">{copy.heading}</h2>
      <p class="consent__body" set:html={body} />
    </div>
    <div class="consent__actions">
      <button type="button" class="btn consent__button" data-consent="denied">
        {copy.reject}
      </button>
      <button type="button" class="btn btn--primary" data-consent="granted">
        {copy.accept}
      </button>
    </div>
  </div>
</div>

<script is:inline set:html={bootstrap} />

<style>
  /*
   * The banner is a bar across the bottom of the viewport, in the same
   * shape as the Superdesign draft: the text on the left, the two
   * buttons on the right, and the bar stacks on a narrow screen.
   */
  .consent {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 100;
    padding: var(--space-5);
    pointer-events: none;
  }

  .consent:focus {
    outline: none;
  }

  .consent__inner {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
  }

  .consent__text {
    flex: 1 1 auto;
  }

  .consent__heading {
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
  }

  .consent__body {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .consent__body :global(a) {
    color: var(--accent-link);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .consent__actions {
    display: flex;
    gap: var(--space-3);
    width: 100%;
  }

  .consent__button {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
  }

  .consent__button:hover {
    background: var(--surface-raised);
    border-color: var(--border-strong);
  }

  @media (min-width: 720px) {
    .consent__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-6) var(--space-8);
    }

    .consent__actions {
      width: auto;
      flex-shrink: 0;
    }
  }
</style>
