---
/**
 * Ad slot.
 *
 * This is the hand-placed counterpart to AdSense auto ads. The auto ads
 * that the loader script switches on are placed by Google, wherever it
 * decides they fit. These three are placed by hand: one in the result
 * panel, one in the article, one at the foot of the page.
 *
 * They render nothing at all until their slot ID is configured. That is
 * deliberate: an <ins> element on a page that has no publisher content
 * behind it is one of the reasons sites get rejected, and a page that
 * carries both auto ads and manual units is a page with too many ads.
 *
 * The prop is called "placement" rather than "slot" on purpose. "slot" is
 * reserved by Astro: on a component that is a direct child of another
 * component, `slot="x"` means "render me into the parent's x slot", and a
 * parent without that named slot drops the component silently. A prop named
 * "slot" therefore loses ad slots on some pages and keeps them on others,
 * which is a very expensive kind of quiet.
 */
import { SITE } from '../config/site.ts';

interface Props {
  placement: 'result' | 'in-article' | 'footer';
}

const { placement } = Astro.props;

const client = import.meta.env.PUBLIC_ADSENSE_CLIENT || SITE.adsensePublisherId;
const slotIds = {
  result: import.meta.env.PUBLIC_ADSENSE_SLOT_RESULT,
  'in-article': import.meta.env.PUBLIC_ADSENSE_SLOT_IN_ARTICLE,
  footer: import.meta.env.PUBLIC_ADSENSE_SLOT_FOOTER,
};

const slotId = slotIds[placement];
const enabled = Boolean(slotId);
---

{
  enabled && (
    <ins
      class="adsbygoogle"
      data-ad-client={client}
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    />
  )
}
