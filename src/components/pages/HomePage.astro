---
import Base from '../../layouts/Base.astro';
import AdSlot from '../AdSlot.astro';
import Newsletter from '../Newsletter.astro';
import HeroVisual from '../visuals/HeroVisual.astro';
import ToolIllustration from '../visuals/ToolIllustration.astro';
import { getSite } from '../../config/site.ts';
import { getTools } from '../../config/tools.ts';
import { getUi } from '../../i18n/ui/index.ts';
import { localePath, type Locale } from '../../i18n/locales.ts';
import { getGuides, guideSlug } from '../../i18n/guides.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
const ui = getUi(locale);
const tools = getTools(locale);

const guides = await getGuides(locale);
const featured = guides.slice(0, 5);

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.origin,
  description: site.description,
  inLanguage: site.lang,
};

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.origin,
  logo: new URL('/favicon.svg', site.origin).toString(),
};
---

<Base
  title={`${site.name} — ${site.tagline}`}
  description={ui.home.description}
  path={localePath(locale, '/')}
  locale={locale}
  jsonLd={[webSite, organization]}
>
  <section class="section-sm hero-section">
    <div class="container">
      <div class="hero">
        <div>
          <p class="eyebrow">{ui.home.eyebrow}</p>
          <h1 class="hero__heading">
            {ui.home.heading}
          </h1>
          <p class="page-head__lede">{ui.home.lede}</p>
          <div style="margin-top: var(--space-8);">
            <a class="btn btn--primary" href={localePath(locale, '/tools/')}>
              {ui.home.cta}
            </a>
          </div>
        </div>
        <HeroVisual locale={locale} />
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <p class="eyebrow">{ui.home.calculatorsEyebrow}</p>
      <h2 style="margin-top: var(--space-2); font-size: var(--text-2xl);">
        {ui.home.calculatorsHeading}
      </h2>
      <div class="grid grid--3" style="margin-top: var(--space-8);">
        {
          tools.map((tool) => (
            <a class="tile" href={localePath(locale, `/tools/${tool.slug}/`)}>
              <div class="tile__figure">
                <ToolIllustration slug={tool.slug} locale={locale} />
              </div>
              <span class="tile__title">{tool.name}</span>
              <span class="tile__text">{tool.short}</span>
              <span class="tile__meta">{ui.ui.calculate}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="card card--raised showcase-grid">
        <div>
          <h2 style="font-size: var(--text-2xl);">{ui.home.workHeading}</h2>
          <ul class="check-list">
            {ui.home.workPoints.map((point) => <li>{point}</li>)}
          </ul>
          <p style="margin-top: var(--space-6);">
            <a class="btn" href={localePath(locale, '/about/')}>{ui.home.workLink}</a>
          </p>
        </div>
        <div class="result">
          <p class="result__label">{ui.home.sampleMonthlyPayment}</p>
          <p class="result__headline" style="font-size: var(--text-3xl);">$2,358.42</p>
          <div class="stat-grid">
            <div class="stat">
              <p class="stat__label">{ui.home.samplePrincipalAndInterest}</p>
              <p class="stat__value">$1,984.12</p>
            </div>
            <div class="stat">
              <p class="stat__label">{ui.home.samplePropertyTax}</p>
              <p class="stat__value">$280.00</p>
            </div>
            <div class="stat">
              <p class="stat__label">{ui.home.sampleTotalInterest}</p>
              <p class="stat__value">$446,031</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="guides-header">
        <div>
          <p class="eyebrow">{ui.home.guidesEyebrow}</p>
          <h2 style="margin-top: var(--space-2); font-size: var(--text-2xl);">
            {ui.home.guidesHeading}
          </h2>
        </div>
        <a class="btn" href={localePath(locale, '/guides/')}>{ui.ui.allGuides}</a>
      </div>
      <div class="guide-list">
        {
          featured.map((guide) => (
            <a
              class="guide-row"
              href={localePath(locale, `/guides/${guideSlug(guide.id)}/`)}
            >
              <span class="guide-row__title">{guide.data.title}</span>
              <span class="guide-row__meta">
                {ui.ui.minRead.replace('{n}', String(guide.data.readingMinutes))}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <AdSlot placement="in-article" />

  <section class="section-sm">
    <div class="container" style="max-width: 720px;">
      <div class="card">
        <h2 style="font-size: var(--text-xl);">{ui.home.newsletterHeading}</h2>
        <p class="text-secondary" style="margin-top: var(--space-2);">
          {ui.home.newsletterLede}
        </p>
        <div style="margin-top: var(--space-5);">
          <Newsletter locale={locale} />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-10);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: var(--space-10);
    align-items: center;
  }

  .hero__heading {
    margin-top: var(--space-4);
    font-size: clamp(2.4rem, 4.6vw, 3.4rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
    background: linear-gradient(135deg, var(--text) 0%, var(--accent-ink-strong) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (max-width: 940px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  .guides-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .guide-list {
    margin-top: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .guide-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    color: inherit;
    transition:
      background-color var(--transition),
      color var(--transition);
  }

  .guide-row:last-child {
    border-bottom: none;
  }

  .guide-row:hover {
    background: var(--surface-raised);
  }

  .guide-row:hover .guide-row__title {
    color: var(--accent-ink);
  }

  .guide-row__title {
    color: var(--text);
    font-weight: 550;
    transition: color var(--transition);
  }

  .guide-row__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 550;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .guide-row__meta::after {
    content: '→';
    color: var(--accent-ink);
    transition: transform var(--transition);
  }

  .guide-row:hover .guide-row__meta::after {
    transform: translateX(3px);
  }
</style>
