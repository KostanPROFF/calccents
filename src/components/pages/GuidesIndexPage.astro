---
import Base from '../../layouts/Base.astro';
import AdSlot from '../AdSlot.astro';
import { getSite } from '../../config/site.ts';
import { getUi } from '../../i18n/ui/index.ts';
import { localePath, type Locale } from '../../i18n/locales.ts';
import { getGuides, guideSlug } from '../../i18n/guides.ts';
import ToolGlyph from '../visuals/ToolGlyph.astro';
import { tileHue } from '../visuals/toolGlyphs.ts';
import { isToolSlug, type ToolSlug } from '../../config/tools.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
const ui = getUi(locale);

const guides = await getGuides(locale);

const groups = ['home', 'renting', 'investing'] as const;

/** The calculator a guide card wears the badge of: the first one it explains. */
const FALLBACK_TOOL: Record<(typeof groups)[number], ToolSlug> = {
  home: 'mortgage-payment',
  renting: 'rent-vs-buy',
  investing: 'compound-interest',
};

function badgeFor(related: string[], group: (typeof groups)[number]): ToolSlug {
  return related.find(isToolSlug) ?? FALLBACK_TOOL[group];
}
const byGroup = groups
  .map((group) => ({ group, guides: guides.filter((guide) => guide.data.group === group) }))
  .filter((entry) => entry.guides.length > 0);
---

<Base
  title={ui.guidesIndex.title}
  description={ui.guidesIndex.description}
  path={localePath(locale, '/guides/')}
  locale={locale}
>
  <div class="container">
    <div class="page-head">
      <nav class="breadcrumb" aria-label={ui.ui.breadcrumb}>
        <a href={localePath(locale, '/')}>{ui.ui.home}</a>
        <span aria-hidden="true">/</span>
        <span>{ui.nav.guides}</span>
      </nav>
      <h1>{ui.guidesIndex.heading}</h1>
      <p class="page-head__lede">
        {ui.guidesIndex.lede}
      </p>
      <div class="reviewed-line" style="margin-top: var(--space-5);">
        <span>{ui.ui.guidesCount(guides.length)}</span>
        <span aria-hidden="true">·</span>
        <span>
          {ui.ui.by}{' '}
          <a href={localePath(locale, '/editorial-team/')}>{site.author.name}</a>
        </span>
      </div>
    </div>

    {
      byGroup.map((entry) => (
        <section class="section-sm">
          <p class="eyebrow">
            {ui.guidesIndex.groups[entry.group]}
          </p>
          <div class="guide-grid">
            {entry.guides.map((guide) => (
              <a
                class="guide-card"
                href={localePath(locale, `/guides/${guideSlug(guide.id)}/`)}
                style={tileHue(badgeFor(guide.data.relatedTools, guide.data.group))}
              >
                <span class="guide-card__figure">
                  <ToolGlyph slug={badgeFor(guide.data.relatedTools, guide.data.group)} size="sm" />
                </span>
                <span class="guide-card__title">{guide.data.title}</span>
                <span class="guide-card__desc">{guide.data.description}</span>
                <span class="guide-card__meta">
                  {ui.ui.minRead.replace('{n}', String(guide.data.readingMinutes))}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <AdSlot placement="in-article" />

    <section class="section-sm">
      <div class="card">
        <h2 style="font-size: var(--text-xl);">{ui.guidesIndex.missingHeading}</h2>
        <p class="text-secondary" style="margin-top: var(--space-3); max-width: 60ch;">
          {ui.guidesIndex.missingBody}
        </p>
        <p style="margin-top: var(--space-5);">
          <a class="btn" href={localePath(locale, '/contact/')}>
            {ui.guidesIndex.suggestTopic}
          </a>
        </p>
      </div>
    </section>

    <AdSlot placement="footer" />
  </div>
</Base>

<style>
  /*
   * The guides are cards, not rows.
   *
   * Every card wears the badge of the calculator it explains, so the
   * index reads as a shelf of the things the site explains rather than as
   * a list of titles.
   */
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .guide-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 16px);
    background:
      radial-gradient(120% 80% at 0% 0%, var(--tile-hue, transparent) 0%, transparent 55%),
      var(--glass);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 0 var(--surface-shine),
      var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--transition),
      background-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .guide-card:hover {
    border-color: var(--accent-border);
    box-shadow:
      inset 0 1px 0 0 var(--surface-shine),
      var(--glow-accent);
    transform: translateY(-4px);
  }

  .guide-card:hover .guide-card__title {
    color: var(--accent-ink);
  }

  .guide-card__figure {
    display: block;
    margin-bottom: var(--space-4);
  }

  .guide-card__title {
    display: block;
    color: var(--text);
    font-weight: 650;
    font-size: var(--text-base);
    letter-spacing: -0.015em;
    line-height: 1.35;
    transition: color var(--transition);
  }

  .guide-card__desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: var(--space-2);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .guide-card__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-4);
    color: var(--accent-ink);
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .guide-card__meta::after {
    content: '→';
    display: inline-block;
    transition: transform var(--transition);
  }

  .guide-card:hover .guide-card__meta::after {
    transform: translateX(3px);
  }

  @media (max-width: 940px) {
    .guide-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .guide-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
