---
import Base from '../../layouts/Base.astro';
import AdSlot from '../AdSlot.astro';
import { getSite } from '../../config/site.ts';
import { getUi } from '../../i18n/ui/index.ts';
import { localePath, type Locale } from '../../i18n/locales.ts';
import { getGuides, guideSlug } from '../../i18n/guides.ts';
import GuideIllustration from '../visuals/GuideIllustration.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
const ui = getUi(locale);

const guides = await getGuides(locale);

const groups = ['home', 'renting', 'investing'] as const;
const byGroup = groups
  .map((group) => ({ group, guides: guides.filter((guide) => guide.data.group === group) }))
  .filter((entry) => entry.guides.length > 0);
---

<Base
  title={ui.guidesIndex.title}
  description={ui.guidesIndex.description}
  path={localePath(locale, '/guides/')}
  locale={locale}
>
  <div class="container">
    <div class="page-head">
      <nav class="breadcrumb" aria-label={ui.ui.breadcrumb}>
        <a href={localePath(locale, '/')}>{ui.ui.home}</a>
        <span aria-hidden="true">/</span>
        <span>{ui.nav.guides}</span>
      </nav>
      <h1>{ui.guidesIndex.heading}</h1>
      <p class="page-head__lede">
        {ui.guidesIndex.lede}
      </p>
      <div class="reviewed-line" style="margin-top: var(--space-5);">
        <span>{ui.ui.guidesCount(guides.length)}</span>
        <span aria-hidden="true">·</span>
        <span>
          {ui.ui.by}{' '}
          <a href={localePath(locale, '/editorial-team/')}>{site.author.name}</a>
        </span>
      </div>
    </div>

    {
      byGroup.map((entry) => (
        <section class="section-sm">
          <p class="eyebrow" style="color: var(--text-muted);">
            {ui.guidesIndex.groups[entry.group]}
          </p>
          <div class="guide-grid">
            {entry.guides.map((guide) => (
              <a
                class="guide-card"
                href={localePath(locale, `/guides/${guideSlug(guide.id)}/`)}
              >
                <span class="guide-card__figure">
                  <GuideIllustration slug={guide.data.illustration} locale={locale} />
                </span>
                <span class="guide-card__title">{guide.data.title}</span>
                <span class="guide-card__desc">{guide.data.description}</span>
                <span class="guide-card__meta">
                  {ui.ui.minRead.replace('{n}', String(guide.data.readingMinutes))}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <AdSlot placement="in-article" />

    <section class="section-sm">
      <div class="card">
        <h2 style="font-size: var(--text-xl);">{ui.guidesIndex.missingHeading}</h2>
        <p class="text-secondary" style="margin-top: var(--space-3); max-width: 60ch;">
          {ui.guidesIndex.missingBody}
        </p>
        <p style="margin-top: var(--space-5);">
          <a class="btn" href={localePath(locale, '/contact/')}>
            {ui.guidesIndex.suggestTopic}
          </a>
        </p>
      </div>
    </section>

    <AdSlot placement="footer" />
  </div>
</Base>

<style>
  /*
   * The guides are cards, not rows.
   *
   * Every card carries the picture of the guide it links to, so the index
   * reads as a shelf of the things the site explains rather than as a list
   * of titles.
   */
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 14px);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .guide-card:hover {
    border-color: var(--border-strong);
    background: var(--surface-raised);
  }

  .guide-card:hover .guide-card__title {
    color: var(--accent-ink);
  }

  .guide-card__figure {
    display: block;
    margin-bottom: var(--space-4);
  }

  .guide-card__title {
    display: block;
    color: var(--text);
    font-weight: 500;
    line-height: 1.35;
  }

  .guide-card__desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .guide-card__meta {
    margin-top: var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 940px) {
    .guide-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .guide-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
