---
import Base from '../../layouts/Base.astro';
import AdSlot from '../AdSlot.astro';
import ContactForm from '../ContactForm.astro';
import { getSite } from '../../config/site.ts';
import { getUi, fill } from '../../i18n/ui/index.ts';
import { localePath, type Locale } from '../../i18n/locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
const ui = getUi(locale);
const copy = ui.contact;

const emailLine = fill(copy.emailLine, { email: site.email });
---

<Base
  title={copy.title}
  description={copy.description}
  path={localePath(locale, '/contact/')}
  locale={locale}
>
  <div class="container">
    <div class="page-head">
      <nav class="breadcrumb" aria-label={ui.ui.breadcrumb}>
        <a href={localePath(locale, '/')}>{ui.ui.home}</a>
        <span aria-hidden="true">/</span>
        <span>{copy.title}</span>
      </nav>
      <h1>{copy.heading}</h1>
      <p class="page-head__lede">{copy.lede}</p>
    </div>

    <div class="prose">
      <p set:html={emailLine} />

      <h2>{copy.worthHeading}</h2>
      <ul>
        {
          copy.worth.map((item) => (
            <li>
              <strong>{item.label}</strong> {item.body}
            </li>
          ))
        }
      </ul>

      <h2>{copy.nextHeading}</h2>
      <p>{copy.nextBody}</p>
    </div>

    <section class="contact-section">
      <h2>{ui.contactForm.heading}</h2>
      <p class="contact-section__lede">{ui.contactForm.lede}</p>
      <ContactForm locale={locale} />
    </section>

    <AdSlot placement="footer" />
  </div>
</Base>

<style>
  .contact-section {
    margin-block: var(--space-8);
    padding-block-start: var(--space-8);
    border-block-start: 1px solid var(--border-subtle);
  }

  .contact-section h2 {
    margin-block-end: var(--space-3);
  }

  .contact-section__lede {
    color: var(--text-muted);
    margin-block-end: var(--space-2);
  }
</style>
