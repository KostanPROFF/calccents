---
import Base from '../../layouts/Base.astro';
import AdSlot from '../AdSlot.astro';
import { getSite } from '../../config/site.ts';
import { getUi, fill } from '../../i18n/ui/index.ts';
import { formatDate, localePath, type Locale } from '../../i18n/locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
const ui = getUi(locale);
const copy = ui.privacy;

const cookiesBody = fill(copy.cookiesBody, { name: site.name });

const advertisingBody = fill(copy.advertisingBody, {
  adsSettingsLink: `<a href="https://adssettings.google.com/" rel="noopener">${copy.adsSettingsLink}</a>`,
  policiesLink: `<a href="https://policies.google.com/technologies/ads" rel="noopener">${copy.policiesLink}</a>`,
});

/**
 * The analytics section links to Google's general privacy policy, which is
 * a different page from the one the advertising section points at.
 */
const analyticsBody = fill(copy.analyticsBody, {
  analyticsPoliciesLink: `<a href="https://policies.google.com/privacy" rel="noopener">${copy.analyticsPoliciesLink}</a>`,
});

/**
 * The consent section ends with the same button the footer carries. It
 * opens the banner rather than going anywhere, so it is a button and not a
 * link.
 */
const consentBody = fill(copy.consentBody, {
  settingsLink: `<button type="button" class="link-button" data-consent-open>${ui.consent.settings}</button>`,
});
---

<Base
  title={copy.title}
  description={copy.description}
  path={localePath(locale, '/privacy/')}
  locale={locale}
>
  <div class="container">
    <div class="page-head">
      <nav class="breadcrumb" aria-label={ui.ui.breadcrumb}>
        <a href={localePath(locale, '/')}>{ui.ui.home}</a>
        <span aria-hidden="true">/</span>
        <span>{copy.title}</span>
      </nav>
      <h1>{copy.heading}</h1>
      <p class="page-head__lede">{copy.lede}</p>
    </div>

    <div class="prose">
      <h2>{copy.calculatorsHeading}</h2>
      <p>{copy.calculatorsBody}</p>

      <h2>{copy.cookiesHeading}</h2>
      <p set:html={cookiesBody} />

      <h2>{copy.advertisingHeading}</h2>
      <p set:html={advertisingBody} />

      <h2>{copy.analyticsHeading}</h2>
      <p set:html={analyticsBody} />

      <h2>{copy.hostingAnalyticsHeading}</h2>
      <p>{copy.hostingAnalyticsBody}</p>

      <h2>{copy.newsletterHeading}</h2>
      <p>{copy.newsletterBody}</p>

      <h2>{copy.contactHeading}</h2>
      <p>{copy.contactBody}</p>

      <h2>{copy.thirdPartyHeading}</h2>
      <p>{copy.thirdPartyBody}</p>

      <h2>{copy.changesHeading}</h2>
      <p>{copy.changesBody}</p>

      <h2>{copy.consentHeading}</h2>
      <p set:html={consentBody} />

      <p class="text-muted">
        {fill(copy.lastReviewed, { date: formatDate(site.reviewedOn, locale) })}
      </p>
    </div>

    <AdSlot placement="footer" />
  </div>
</Base>

<style>
  /*
    A button that reads as a link: it opens the banner instead of
    navigating anywhere, but the sentence around it is a paragraph.

    The rule is global on purpose. Astro scopes the styles of a component
    to the elements it renders, and this button arrives through set:html,
    so it never carries the scope attribute and a scoped rule would not
    reach it. Left unscoped, the button kept the browser's own grey and
    its own text colour, and the sentence read at a fraction of the
    contrast the page is written to.
  */
  :global(.link-button) {
    padding: 0;
    background: none;
    border: none;
    color: var(--accent-link);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  :global(.link-button:hover) {
    color: var(--accent-link-hover);
  }
</style>
