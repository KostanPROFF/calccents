---
/**
 * The small picture that sits on top of a calculator card.
 *
 * Every calculator gets one, drawn as inline SVG from the design tokens, so
 * the page carries no image file and no second request. The drawing is
 * abstract on purpose: it shows the shape of the arithmetic the tool does,
 * not numbers, because a number here would be a number nobody can check.
 *
 * The strokes use the theme variables and nothing else, which is what keeps
 * the picture readable when the reader switches to the light theme.
 *
 * Every picture is built the same way: a grid of hairlines, a few quiet
 * background columns, the main shape of the topic in the accent colour, a
 * soft gradient under it, one second line, sometimes a dashed third line, one
 * marker on the point that matters and a scatter of small data dots.
 */

import { getUi } from '../../i18n/ui/index.ts';
import type { UiDictionary } from '../../i18n/ui/index.ts';
import type { Locale } from '../../i18n/locales.ts';
import type { ToolSlug } from '../../config/tools.ts';
import { nextFigureId } from './guideIllustrations.ts';

interface Props {
  /** Which calculator the picture belongs to. */
  slug: ToolSlug;
  /** The language the page is in; the alt text comes from the dictionary. */
  locale: Locale;
  /** Extra class for the frame, if the page needs one. */
  class?: string;
}

const { slug, locale, class: className } = Astro.props;

/** The key each picture's alt text sits under in the dictionary. */
const ALT_KEYS = {
  'mortgage-payment': 'mortgagePayment',
  'rent-vs-buy': 'rentVsBuy',
  'compound-interest': 'compoundInterest',
  'net-pay': 'netPay',
  'income-tax': 'incomeTax',
  'debt-payoff': 'debtPayoff',
} as const satisfies Record<ToolSlug, keyof UiDictionary['illustration']>;

const alt = getUi(locale).illustration?.[ALT_KEYS[slug]] ?? '';

/** The edges of the drawing area every picture shares. */
const PLOT = { left: 18, right: 222, floor: 140 } as const;

/**
 * The furniture every picture carries.
 *
 * `grid` is the horizontal hairlines, `columns` the quiet background columns
 * standing on the floor, and `dots` the small points of data scattered over
 * the field. They are drawn first, so the shape of the topic sits on top.
 */
interface Scene {
  grid: readonly number[];
  columns: readonly { x: number; y: number; w: number; h: number }[];
  dots: readonly { x: number; y: number }[];
}

const SCENES: Record<ToolSlug, Scene> = {
  // The balance of the loan falls away; behind it the amortization columns
  // shrink as the loan gets older.
  'mortgage-payment': {
    grid: [46, 82, 116],
    columns: [
      { x: 30, y: 92, w: 5, h: 48 },
      { x: 54, y: 98, w: 5, h: 42 },
      { x: 78, y: 106, w: 5, h: 34 },
      { x: 102, y: 112, w: 5, h: 28 },
    ],
    dots: [
      { x: 70, y: 56 },
      { x: 150, y: 78 },
      { x: 196, y: 98 },
    ],
  },
  // The two costs run past each other; the marker sits where they meet.
  'rent-vs-buy': {
    grid: [42, 78, 114],
    columns: [
      { x: 40, y: 112, w: 5, h: 28 },
      { x: 64, y: 104, w: 5, h: 36 },
      { x: 88, y: 116, w: 5, h: 24 },
      { x: 112, y: 108, w: 5, h: 32 },
    ],
    dots: [
      { x: 56, y: 44 },
      { x: 186, y: 96 },
      { x: 206, y: 56 },
    ],
  },
  // The balance bends upwards; the columns are the regular deposits.
  'compound-interest': {
    grid: [40, 76, 112],
    columns: [
      { x: 36, y: 118, w: 5, h: 22 },
      { x: 64, y: 118, w: 5, h: 22 },
      { x: 92, y: 118, w: 5, h: 22 },
      { x: 120, y: 118, w: 5, h: 22 },
    ],
    dots: [
      { x: 62, y: 64 },
      { x: 96, y: 84 },
      { x: 186, y: 44 },
    ],
  },
  // One column of gross pay, cut into the parts it is made of.
  'net-pay': {
    grid: [40, 76, 112],
    columns: [
      { x: 34, y: 104, w: 5, h: 36 },
      { x: 58, y: 116, w: 5, h: 24 },
      { x: 200, y: 108, w: 5, h: 32 },
      { x: 214, y: 120, w: 5, h: 20 },
    ],
    dots: [
      { x: 84, y: 50 },
      { x: 84, y: 92 },
      { x: 156, y: 40 },
      { x: 156, y: 100 },
    ],
  },
  // The brackets, each one wider than the one above it.
  'income-tax': {
    grid: [40, 72, 104],
    columns: [
      { x: 44, y: 60, w: 6, h: 80 },
      { x: 84, y: 80, w: 6, h: 60 },
      { x: 124, y: 52, w: 6, h: 88 },
      { x: 164, y: 72, w: 6, h: 68 },
    ],
    dots: [
      { x: 34, y: 32 },
      { x: 100, y: 104 },
      { x: 196, y: 60 },
    ],
  },
  // Two orders of the same debts, side by side.
  'debt-payoff': {
    grid: [44, 80, 116],
    columns: [
      { x: 22, y: 70, w: 4, h: 70 },
      { x: 118, y: 90, w: 4, h: 50 },
      { x: 216, y: 76, w: 4, h: 64 },
    ],
    dots: [
      { x: 28, y: 40 },
      { x: 120, y: 60 },
      { x: 212, y: 36 },
    ],
  },
};

const scene = SCENES[slug];

/** The gradient under the main shape, and a quieter one for the second line. */
const fillId = nextFigureId(`tool-fill-${slug}`);
const fillBarId = nextFigureId(`tool-fill-bar-${slug}`);
const fillWideId = nextFigureId(`tool-fill-wide-${slug}`);
---

<div class:list={['fig__frame', className]}>
  <svg
    class="fig"
    viewBox="0 0 240 160"
    preserveAspectRatio="xMidYMid meet"
    role={alt ? 'img' : undefined}
    aria-label={alt || undefined}
    aria-hidden={alt ? undefined : 'true'}
    focusable="false"
  >
    <defs>
      <linearGradient id={fillId} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.3"></stop>
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient id={fillBarId} x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.34"></stop>
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient id={fillWideId} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.3"></stop>
        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
      </linearGradient>
    </defs>

    {/* The quiet background: a grid of hairlines and a few standing columns. */}
    <g>
      {
        scene.grid.map((y) => (
          <line
            x1={PLOT.left}
            y1={y}
            x2={PLOT.right}
            y2={y}
            stroke="var(--border-subtle)"
            stroke-width="1"
            vector-effect="non-scaling-stroke"
          />
        ))
      }
      {
        scene.columns.map((column) => (
          <rect
            x={column.x}
            y={column.y}
            width={column.w}
            height={column.h}
            fill="var(--surface-raised)"
          />
        ))
      }
      <line
        x1={PLOT.left}
        y1={PLOT.floor}
        x2={PLOT.right}
        y2={PLOT.floor}
        stroke="var(--border)"
        stroke-width="1"
        vector-effect="non-scaling-stroke"
      />
    </g>

    {
      slug === 'mortgage-payment' && (
        <g>
          {/* The balance left on the loan, falling away fast at first. */}
          <path
            d="M18 30 C 46 62 78 84 110 100 C 150 119 190 128 222 132 L222 140 L18 140 Z"
            fill={`url(#${fillId})`}
          />
          <path
            d="M18 30 C 46 62 78 84 110 100 C 150 119 190 128 222 132"
            fill="none"
            stroke="var(--accent)"
            stroke-width="2.25"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          {/* The share of the payment that goes on interest, also falling. */}
          <path
            d="M18 48 C 90 64 160 86 222 108"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          {/* The share that goes on principal, rising as the balance shrinks. */}
          <path
            d="M18 116 C 90 118 160 106 222 86"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1"
            stroke-dasharray="4 4"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          <circle cx="110" cy="100" r="3" fill="var(--accent)" />
        </g>
      )
    }

    {
      slug === 'rent-vs-buy' && (
        <g>
          {/* Rent paid out, year on year. */}
          <path
            d="M18 134 C 60 120 90 100 125 79 C 160 58 190 44 222 30 L222 140 L18 140 Z"
            fill={`url(#${fillId})`}
          />
          <path
            d="M18 134 C 60 120 90 100 125 79 C 160 58 190 44 222 30"
            fill="none"
            stroke="var(--accent)"
            stroke-width="2.25"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          {/* The net cost of owning, which starts higher and comes down to meet it. */}
          <path
            d="M18 28 C 60 46 90 64 125 79 C 160 95 190 112 222 126"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.25"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          {/* The level at which the two costs are the same. */}
          <line
            x1={PLOT.left}
            y1="79"
            x2={PLOT.right}
            y2="79"
            stroke="var(--text-muted)"
            stroke-width="1"
            stroke-dasharray="4 4"
            vector-effect="non-scaling-stroke"
          />
          <circle cx="125" cy="79" r="3" fill="var(--accent)" />
        </g>
      )
    }

    {
      slug === 'compound-interest' && (
        <g>
          {/* A balance that grows faster and faster. */}
          <path
            d="M18 136 C 70 132 120 118 150 92 C 180 68 200 46 222 22 L222 140 L18 140 Z"
            fill={`url(#${fillId})`}
          />
          <path
            d="M18 136 C 70 132 120 118 150 92 C 180 68 200 46 222 22"
            fill="none"
            stroke="var(--accent)"
            stroke-width="2.5"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          {/* The same money growing, but more slowly. */}
          <path
            d="M18 136 C 80 130 150 112 222 62"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.25"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          {/* Interest paid on the original balance only, for comparison. */}
          <path
            d="M18 136 L222 44"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1"
            stroke-dasharray="4 4"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          <circle cx="150" cy="92" r="3" fill="var(--accent)" />
        </g>
      )
    }

    {
      slug === 'net-pay' && (
        <g>
          {/* One column of gross pay, cut into the parts it is made of. */}
          {/* The deductions, each one a band of its own. */}
          <rect
            x="96"
            y="24"
            width="48"
            height="12"
            fill="var(--text-muted)"
            fill-opacity="0.1"
            stroke="var(--border-strong)"
            stroke-width="1"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="96"
            y="36"
            width="48"
            height="16"
            fill="var(--text-muted)"
            fill-opacity="0.16"
            stroke="var(--border-strong)"
            stroke-width="1"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="96"
            y="52"
            width="48"
            height="20"
            fill="var(--text-muted)"
            fill-opacity="0.24"
            stroke="var(--border-strong)"
            stroke-width="1"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="96"
            y="72"
            width="48"
            height="28"
            fill="var(--text-muted)"
            fill-opacity="0.32"
            stroke="var(--border-strong)"
            stroke-width="1"
            vector-effect="non-scaling-stroke"
          />
          {/* What the reader actually receives. */}
          <rect
            x="96"
            y="100"
            width="48"
            height="40"
            fill={`url(#${fillBarId})`}
            stroke="var(--accent)"
            stroke-width="1.75"
            vector-effect="non-scaling-stroke"
          />
          {/* The hairline frame around the whole column. */}
          <rect
            x="96"
            y="24"
            width="48"
            height="116"
            fill="none"
            stroke="var(--border-strong)"
            stroke-width="1"
            vector-effect="non-scaling-stroke"
          />
          <circle cx="120" cy="120" r="3" fill="var(--accent)" />
        </g>
      )
    }

    {
      slug === 'income-tax' && (
        <g>
          {/* The tax brackets, each one wider than the one above it. */}
          <rect
            x="20"
            y="24"
            width="40"
            height="12"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="20"
            y="42"
            width="66"
            height="12"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="20"
            y="60"
            width="92"
            height="12"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            vector-effect="non-scaling-stroke"
          />
          {/* The bracket the reader has reached, picked out of the row. */}
          <rect
            x="20"
            y="78"
            width="118"
            height="12"
            fill={`url(#${fillWideId})`}
            stroke="var(--accent)"
            stroke-width="1.75"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="20"
            y="96"
            width="146"
            height="12"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="20"
            y="114"
            width="176"
            height="12"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            vector-effect="non-scaling-stroke"
          />
          <circle cx="138" cy="84" r="3" fill="var(--accent)" />
        </g>
      )
    }

    {
      slug === 'debt-payoff' && (
        <g>
          {/* Avalanche: the largest debt goes first, so the tall bar is first. */}
          <rect
            x="34"
            y="68"
            width="13"
            height="72"
            fill={`url(#${fillId})`}
            stroke="var(--accent)"
            stroke-width="1.75"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="56"
            y="90"
            width="13"
            height="50"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="78"
            y="98"
            width="13"
            height="42"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="100"
            y="106"
            width="13"
            height="34"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            vector-effect="non-scaling-stroke"
          />
          {/* Snowball: the smallest debt goes first, so the short bar is first. */}
          <rect
            x="138"
            y="106"
            width="13"
            height="34"
            fill={`url(#${fillId})`}
            stroke="var(--accent)"
            stroke-width="1.75"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="160"
            y="98"
            width="13"
            height="42"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="182"
            y="90"
            width="13"
            height="50"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            vector-effect="non-scaling-stroke"
          />
          <rect
            x="204"
            y="68"
            width="13"
            height="72"
            fill="none"
            stroke="var(--text-muted)"
            stroke-width="1.15"
            vector-effect="non-scaling-stroke"
          />
          <circle cx="40.5" cy="64" r="3" fill="var(--accent)" />
        </g>
      )
    }

    {/* A scatter of small points of data over the field. */}
    {
      scene.dots.map((dot) => (
        <circle cx={dot.x} cy={dot.y} r="1.25" fill="var(--text-muted)" fill-opacity="0.7" />
      ))
    }
  </svg>
</div>

<style>
  .fig__frame {
    background: var(--surface-inset);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    /*
     * The frame keeps the proportion of the drawing, so the picture is
     * not stretched when the card it sits in is wider than the drawing.
     * A picture inside the body of a guide sets `--fig-aspect` to a
     * wider shape.
     */
    aspect-ratio: var(--fig-aspect, 3 / 2);
  }

  .fig {
    display: block;
    width: 100%;
    /*
     * The drawing fills the frame, and the frame keeps the proportion of
     * the drawing. With a fixed height here the picture would be fitted
     * into that height and sit in the middle of a wide frame instead of
     * filling it.
     */
    height: 100%;
  }
</style>
