                d="M18 44 C 90 62 160 86 222 110"
                fill="none"
                stroke="var(--text-muted)"
                stroke-width="1.15"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
              {/* The share that goes on principal, rising as the balance shrinks. */}
