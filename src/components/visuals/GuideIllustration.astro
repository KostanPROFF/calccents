  },
  // The nominal balance, climbing with the years.
  'inflation-and-real-returns-explained': {
    grid: [40, 76, 112],
    columns: [
      { x: 32, y: 114, w: 5, h: 26 },
      { x: 58, y: 106, w: 5, h: 34 },
