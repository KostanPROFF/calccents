      { x: 62, y: 60 },
      { x: 96, y: 84 },
      { x: 192, y: 34 },
    ],
  },
};

/** The furniture of the picture this page draws, if it draws one itself. */
const scene = isReusedGuideSlug(slug) ? null : SCENES[slug];

/** The gradient under the main shape, and a quieter one for the second line. */
const fillId = nextFigureId(`guide-fill-${slug}`);
const fillSoftId = nextFigureId(`guide-fill-soft-${slug}`);
const fillWideId = nextFigureId(`guide-fill-wide-${slug}`);
---

{
  isReusedGuideSlug(slug) ? (
    <ToolIllustration
      slug={TOOL_ILLUSTRATION_BY_GUIDE[slug]}
      locale={locale}
      class={className}
    />
  ) : (
    <div class:list={['fig__frame', className]}>
      <svg
        class="fig"
        viewBox="0 0 240 160"
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <linearGradient id={fillId} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.3"></stop>
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id={fillSoftId} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.16"></stop>
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id={fillWideId} x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.3"></stop>
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"></stop>
          </linearGradient>
        </defs>

        {/* The quiet background: a grid of hairlines and a few standing columns. */}
        <g>
          {
            scene?.grid.map((y) => (
              <line
                x1={PLOT.left}
                y1={y}
                x2={PLOT.right}
                y2={y}
                stroke="var(--border-subtle)"
                stroke-width="1"
                vector-effect="non-scaling-stroke"
              />
            ))
          }
          {
            scene?.columns.map((column) => (
              <rect
                x={column.x}
                y={column.y}
                width={column.w}
                height={column.h}
                fill="var(--surface-raised)"
              />
            ))
          }
          <line
            x1={PLOT.left}
            y1={PLOT.floor}
            x2={PLOT.right}
            y2={PLOT.floor}
            stroke="var(--border)"
            stroke-width="1"
            vector-effect="non-scaling-stroke"
          />
        </g>

        {
          slug === 'how-mortgage-amortization-works' && (
            <g>
              {/* The balance left on the loan, falling away fast at first. */}
              <path
                d="M18 26 C 46 60 78 84 110 100 C 150 118 190 128 222 134 L222 140 L18 140 Z"
