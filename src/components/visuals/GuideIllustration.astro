---
/**
 * The small picture that sits on top of a guide.
 *
 * It is the same drawing language as the calculator pictures: inline SVG on
 * the theme tokens, hairline strokes, nothing but shapes. The picture shows
 * the shape of the arithmetic the guide explains, never the numbers, because
 * a number in a picture is a number nobody can check.
 *
 * Six of the guides describe a calculator that already has a picture, so
 * those guides reuse `ToolIllustration` rather than draw the same shape
 * twice. The rest are drawn here.
 *
 * Each drawing is built the same way: a grid of hairlines, a few quiet
 * background columns, the main shape of the topic in the accent colour, a
 * soft gradient under it, one second line, sometimes a dashed third line, one
 * marker on the point that matters and a scatter of small data dots.
 */

import ToolIllustration from './ToolIllustration.astro';
import {
  isReusedGuideSlug,
  nextFigureId,
  TOOL_ILLUSTRATION_BY_GUIDE,
  type GuideIllustrationSlug,
  type ReusedGuideSlug,
} from './guideIllustrations.ts';
import type { Locale } from '../../i18n/locales.ts';

interface Props {
  /** Which guide the picture belongs to. */
  slug: GuideIllustrationSlug;
  /** The language the page is in; the pictures carry no text of their own. */
  locale: Locale;
  /** Extra class for the frame, if the page needs one. */
  class?: string;
}

const { slug, locale, class: className } = Astro.props;

/** The edges of the drawing area every picture shares. */
const PLOT = { left: 18, right: 222, floor: 140 } as const;

/**
 * The furniture every picture carries.
 *
 * `grid` is the horizontal hairlines, `columns` the quiet background columns
 * standing on the floor, and `dots` the small points of data scattered over
 * the field. They are drawn first, so the shape of the topic sits on top.
 */
interface Scene {
  grid: readonly number[];
  columns: readonly { x: number; y: number; w: number; h: number }[];
  dots: readonly { x: number; y: number }[];
}

/** The slugs this file draws itself. */
type DrawnSlug = Exclude<GuideIllustrationSlug, ReusedGuideSlug>;

const SCENES: Record<DrawnSlug, Scene> = {
