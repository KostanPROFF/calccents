      { x: 66, y: 62 },
      { x: 96, y: 86 },
      { x: 190, y: 44 },
    ],
  },
  // Three ways of compounding, each ending a little higher than the last.
  'how-compounding-frequency-changes-results': {
    grid: [40, 76, 112],
    columns: [
      { x: 32, y: 118, w: 5, h: 22 },
      { x: 58, y: 112, w: 5, h: 28 },
