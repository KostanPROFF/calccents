              />
              <path
                d="M18 134 L222 52"
                fill="none"
                stroke="var(--text-muted)"
                stroke-width="1.25"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
              {/* The line the interest alone would follow. */}
              <path
                d="M18 134 C 100 128 170 110 222 78"
                fill="none"
                stroke="var(--text-muted)"
                stroke-width="1"
                stroke-dasharray="4 4"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
              <circle cx="150" cy="90" r="3" fill="var(--accent)" />
            </g>
          )
        }

        {
          slug === 'how-compounding-frequency-changes-results' && (
            <g>
              {/* Three ways of compounding, each ending a little higher than the last. */}
              <path
                d="M18 136 C 70 132 120 118 150 92 C 178 68 200 46 222 22 L222 140 L18 140 Z"
                fill={`url(#${fillId})`}
              />
              <path
                d="M18 136 C 70 132 120 118 150 92 C 178 68 200 46 222 22"
                fill="none"
                stroke="var(--accent)"
                stroke-width="2.5"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
              <path
                d="M18 136 C 70 133 120 122 150 102 C 178 82 200 64 222 44"
                fill="none"
                stroke="var(--text-muted)"
                stroke-width="1.25"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
              <path
                d="M18 136 C 70 134 120 126 150 112 C 178 96 200 82 222 66"
                fill="none"
                stroke="var(--text-muted)"
                stroke-width="1"
                stroke-dasharray="4 4"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
              <circle cx="150" cy="92" r="3" fill="var(--accent)" />
            </g>
          )
        }

        {
          slug === 'inflation-and-real-returns-explained' && (
            <g>
              {/* The nominal balance, climbing with the years. */}
              <path
                d="M18 132 C 70 128 120 114 150 88 C 178 62 200 40 222 18 L222 140 L18 140 Z"
                fill={`url(#${fillId})`}
              />
              <path
                d="M18 132 C 70 128 120 114 150 88 C 178 62 200 40 222 18"
                fill="none"
                stroke="var(--accent)"
                stroke-width="2.5"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
              {/* What the same balance is really worth after inflation. */}
              <path
                d="M18 128 C 70 126 120 122 150 116 C 178 111 200 106 222 100"
                fill="none"
                stroke="var(--text-muted)"
                stroke-width="1.25"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
              {/* The line inflation itself follows. */}
              <path
                d="M18 120 C 80 112 150 96 222 78"
                fill="none"
                stroke="var(--text-muted)"
                stroke-width="1"
                stroke-dasharray="4 4"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
              <circle cx="150" cy="88" r="3" fill="var(--accent)" />
            </g>
          )
        }

        {/* A scatter of small points of data over the field. */}
        {
          scene?.dots.map((dot) => (
            <circle cx={dot.x} cy={dot.y} r="1.25" fill="var(--text-muted)" fill-opacity="0.7" />
          ))
        }
      </svg>
    </div>
  )
}

<style>
  .fig__frame {
    background:
      radial-gradient(90% 90% at 50% 0%, var(--surface-glow) 0%, transparent 75%),
      var(--surface-inset);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: inset 0 1px 0 0 var(--surface-shine);
    overflow: hidden;
    /*
     * The frame keeps the proportion of the drawing, so the picture is
     * not stretched when the column it sits in is wider than the drawing.
     * A picture inside the body of a guide sets `--fig-aspect` to a
     * wider shape.
     */
    aspect-ratio: var(--fig-aspect, 3 / 2);
  }

  .fig {
    display: block;
    width: 100%;
    /*
     * The drawing fills the frame, and the frame keeps the proportion of
     * the drawing. With a fixed height here the picture would be fitted
     * into that height and sit in the middle of a wide frame instead of
     * filling it.
     */
    height: 100%;
  }
</style>
