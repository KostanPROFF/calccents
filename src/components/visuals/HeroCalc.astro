---
/**
 * The working mortgage calculator in the home page hero.
 *
 * It is the smallest honest version of the full tool: four inputs and the
 * principal-and-interest payment, worked out with the same function the
 * mortgage calculator uses. The figure printed in the markup is the result
 * for the default inputs, so the panel reads correctly before the script
 * runs and for a reader without JavaScript.
 */

import { getUi } from '../../i18n/ui/index.ts';
import { fill } from '../../i18n/ui/index.ts';
import { localePath, type Locale } from '../../i18n/locales.ts';
import { computeMonthlyPayment } from '../../lib/calc/mortgage.ts';
import { formatCurrency } from '../../lib/calc/money.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale).home;

const DEFAULTS = { price: 450000, down: 20, rate: 6.5, years: 30 };
const loan = DEFAULTS.price * (1 - DEFAULTS.down / 100);
const monthly = computeMonthlyPayment(loan, DEFAULTS.rate, DEFAULTS.years * 12);
const totalInterest = monthly * DEFAULTS.years * 12 - loan;
---

<form class="hero-calc" id="hero-calc" data-years={t.calcYears}>
  <div class="hero-calc__glow" aria-hidden="true"></div>
  <p class="hero-calc__title">{t.calcTitle}</p>

  <div class="hero-calc__field">
    <div class="hero-calc__row">
      <label for="hero-price">{t.calcHomePrice}</label>
      <output id="hero-price-out" for="hero-price">{formatCurrency(DEFAULTS.price, 0)}</output>
    </div>
    <input id="hero-price" class="range" type="range" min="100000" max="1500000" step="5000" value={DEFAULTS.price} />
  </div>

  <div class="hero-calc__field">
    <div class="hero-calc__row">
      <label for="hero-down">{t.calcDown}</label>
      <output id="hero-down-out" for="hero-down">{DEFAULTS.down}%</output>
    </div>
    <input id="hero-down" class="range" type="range" min="0" max="60" step="1" value={DEFAULTS.down} />
  </div>

  <div class="hero-calc__field">
    <div class="hero-calc__row">
      <label for="hero-rate">{t.calcRate}</label>
      <output id="hero-rate-out" for="hero-rate">{DEFAULTS.rate.toFixed(2)}%</output>
    </div>
    <input id="hero-rate" class="range" type="range" min="1" max="12" step="0.05" value={DEFAULTS.rate} />
  </div>

  <fieldset class="hero-calc__field hero-calc__term">
    <legend>{t.calcTerm}</legend>
    <div class="segmented">
      {
        [10, 15, 20, 30].map((years) => (
          <label class="segmented__option">
            <input type="radio" name="hero-term" value={years} checked={years === DEFAULTS.years} />
            <span>{fill(t.calcYears, { n: years })}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="hero-calc__result">
    <p class="hero-calc__label">{t.calcMonthly}</p>
    <p class="hero-calc__figure" id="hero-monthly" aria-live="polite">{formatCurrency(monthly)}</p>
    <dl class="hero-calc__stats">
      <div>
        <dt>{t.calcLoan}</dt>
        <dd id="hero-loan">{formatCurrency(loan, 0)}</dd>
      </div>
      <div>
        <dt>{t.calcTotalInterest}</dt>
        <dd id="hero-interest">{formatCurrency(totalInterest, 0)}</dd>
      </div>
    </dl>
  </div>

  <p class="hero-calc__note">{t.calcNote}</p>
  <a class="btn btn--block" href={localePath(locale, '/tools/mortgage-payment/')}>
    {t.calcOpen} →
  </a>
</form>

<script>
  import { computeMonthlyPayment } from '../../lib/calc/mortgage.ts';
  import { formatCurrency } from '../../lib/calc/money.ts';
  import { setText } from '../../lib/client/dom.ts';

  const form = document.getElementById('hero-calc') as HTMLFormElement | null;

  function value(id: string): number {
    const input = document.getElementById(id) as HTMLInputElement | null;
    return input ? Number(input.valueAsNumber) : 0;
  }

  /** Paint the filled part of a slider track up to the thumb. */
  function paintTrack(input: HTMLInputElement): void {
    const min = Number(input.min);
    const max = Number(input.max);
    const share = ((input.valueAsNumber - min) / (max - min)) * 100;
    input.style.setProperty('--fill', `${share}%`);
  }

  function update(): void {
    if (!form) return;
    const price = value('hero-price');
    const down = value('hero-down');
    const rate = value('hero-rate');
    const checked = form.querySelector<HTMLInputElement>('input[name="hero-term"]:checked');
    const months = Number(checked?.value ?? 30) * 12;

    const loan = price * (1 - down / 100);
    const monthly = computeMonthlyPayment(loan, rate, months);

    setText('hero-price-out', formatCurrency(price, 0));
    setText('hero-down-out', `${down}%`);
    setText('hero-rate-out', `${rate.toFixed(2)}%`);
    setText('hero-monthly', formatCurrency(monthly));
    setText('hero-loan', formatCurrency(loan, 0));
    setText('hero-interest', formatCurrency(monthly * months - loan, 0));
    form.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach(paintTrack);
  }

  form?.addEventListener('input', update);
  form?.addEventListener('submit', (event) => event.preventDefault());
  update();
</script>

<style>
  .hero-calc {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px solid transparent;
    border-radius: var(--radius-xl);
    background:
      linear-gradient(var(--glass), var(--glass)) padding-box,
      var(--gradient-brand-soft) border-box;
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    backdrop-filter: blur(24px) saturate(150%);
    box-shadow:
      inset 0 1px 0 var(--surface-shine),
      0 40px 80px -30px rgba(124, 92, 255, 0.55);
  }

  .hero-calc__glow {
    position: absolute;
    inset: -30% -20% auto auto;
    z-index: -1;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--aurora-2) 0%, transparent 65%);
    pointer-events: none;
  }

  .hero-calc__title {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--text-secondary);
  }

  .hero-calc__field {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    border: 0;
    padding: 0;
  }

  .hero-calc__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .hero-calc__row output {
    color: var(--text);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .hero-calc__term legend {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .hero-calc__result {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 120% at 0% 0%, var(--accent-subtle) 0%, transparent 60%),
      var(--surface-inset);
    border: 1px solid var(--border);
  }

  .hero-calc__label {
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .hero-calc__figure {
    margin-top: var(--space-1);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 24px rgba(124, 92, 255, 0.4));
  }

  .hero-calc__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .hero-calc__stats dt {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .hero-calc__stats dd {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .hero-calc__note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
