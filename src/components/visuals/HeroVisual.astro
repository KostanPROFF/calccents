---
/**
 * The picture in the hero of the home page.
 *
 * It carries the same demo figure the page shows further down, so the two
 * agree, and it is drawn as inline SVG from the theme variables so it needs
 * no image file and survives the light theme.
 *
 * The curve is decorative: the caption underneath says what it is, and the
 * figure above it is real text, so a screen reader is told everything twice
 * over without the picture joining in.
 */

import { getUi } from '../../i18n/ui/index.ts';
import type { Locale } from '../../i18n/locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
---

<div class="card card--raised hero__visual">
  <div class="hero__visual-head">
    <p class="hero__visual-label">{ui.heroVisual.label}</p>
    <p class="hero__visual-value">$2,358.42</p>
  </div>

  <div class="hero__visual-frame">
    <svg
      class="hero__visual-chart"
      viewBox="0 0 280 124"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient id="hero-chart-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.32" />
          <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.0" />
        </linearGradient>
      </defs>

      {/* Subtle reference grid */}
      <line x1="8" y1="24" x2="272" y2="24" stroke="var(--border-subtle)" stroke-width="1" />
      <line x1="8" y1="56" x2="272" y2="56" stroke="var(--border-subtle)" stroke-width="1" />
      <line x1="8" y1="88" x2="272" y2="88" stroke="var(--border-subtle)" stroke-width="1" />
      <line x1="8" y1="114" x2="272" y2="114" stroke="var(--border)" stroke-width="1" />

      {/* Quiet background columns */}
      <rect x="28" y="86" width="6" height="28" rx="1.5" fill="var(--surface-raised)" />
      <rect x="68" y="76" width="6" height="38" rx="1.5" fill="var(--surface-raised)" />
      <rect x="108" y="64" width="6" height="50" rx="1.5" fill="var(--surface-raised)" />
      <rect x="148" y="48" width="6" height="66" rx="1.5" fill="var(--surface-raised)" />
      <rect x="188" y="34" width="6" height="80" rx="1.5" fill="var(--surface-raised)" />
      <rect x="228" y="20" width="6" height="94" rx="1.5" fill="var(--surface-raised)" />

      {/* The balance left on the loan, drawn the way the calculator draws it. */}
      <path
        d="M8 108 C 56 102 104 80 152 48 C 188 25 226 12 272 8 L272 114 L8 114 Z"
        fill="url(#hero-chart-fill)"
      />
      <path
        d="M8 108 C 56 102 104 80 152 48 C 188 25 226 12 272 8"
        fill="none"
        stroke="var(--accent)"
        stroke-width="2.25"
        stroke-linecap="round"
      />
      {/* The part of the payment that goes on interest, falling away. */}
      <path
        d="M8 76 C 68 72 122 60 176 40 C 216 26 244 16 272 12"
        fill="none"
        stroke="var(--text-muted)"
        stroke-width="1.35"
        stroke-dasharray="4 4"
        stroke-linecap="round"
      />

      {/* Highlighted inflection point */}
      <circle cx="152" cy="48" r="7" fill="var(--accent)" fill-opacity="0.2" />
      <circle cx="152" cy="48" r="3.5" fill="var(--accent)" />
      <circle cx="272" cy="8" r="3" fill="var(--accent)" />
    </svg>
  </div>

  <p class="hero__visual-caption">{ui.heroVisual.caption}</p>
</div>

<style>
  .hero__visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  .hero__visual-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .hero__visual-label {
    color: var(--accent-ink);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__visual-value {
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .hero__visual-frame {
    padding: var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface-inset);
  }

  .hero__visual-chart {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__visual-caption {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
</style>
