---
/**
 * The picture in the hero of the home page.
 *
 * It carries the same demo figure the page shows further down, so the two
 * agree, and it is drawn as inline SVG from the theme variables so it needs
 * no image file and survives the light theme.
 *
 * The curve is decorative: the caption underneath says what it is, and the
 * figure above it is real text, so a screen reader is told everything twice
 * over without the picture joining in.
 */

import { getUi } from '../../i18n/ui/index.ts';
import type { Locale } from '../../i18n/locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
---

<div class="card hero__visual">
  <p class="hero__visual-label">{ui.heroVisual.label}</p>
  <p class="hero__visual-value">$2,358.42</p>

  <hr class="hero__visual-rule" />

  <svg
    class="hero__visual-chart"
    viewBox="0 0 240 96"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    {/* The balance left on the loan, drawn the way the calculator draws it. */}
    <path
      d="M4 88 C 46 84 88 66 128 40 C 158 21 190 8 236 4 L236 92 L4 92 Z"
      fill="var(--accent-subtle)"
    />
    <path
      d="M4 88 C 46 84 88 66 128 40 C 158 21 190 8 236 4"
      fill="none"
      stroke="var(--accent)"
      stroke-width="1.5"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    />
    {/* The part of the payment that goes on interest, falling away. */}
    <path
      d="M4 60 C 58 58 104 48 150 32 C 186 20 210 12 236 8"
      fill="none"
      stroke="var(--text-muted)"
      stroke-width="1.25"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    />
  </svg>

  <p class="hero__visual-caption">{ui.heroVisual.caption}</p>
</div>

<style>
  .hero__visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hero__visual-label {
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__visual-value {
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .hero__visual-rule {
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .hero__visual-chart {
    display: block;
    width: 100%;
    height: 96px;
  }

  .hero__visual-caption {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
</style>
