---
/**
 * Newsletter signup. Renders nothing when no provider is configured, so the
 * site ships without a third-party form until one is set up.
 */
import { getUi } from '../i18n/ui/index.ts';
import type { Locale } from '../i18n/locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const form = import.meta.env.PUBLIC_BUTTONDOWN_FORM;
---

{
  form && (
    <form class="newsletter" action={form} method="post" target="popupwindow">
      <label class="sr-only" for="newsletter-email">
        {ui.newsletter.emailAddress}
      </label>
      <input
        class="input newsletter__input"
        id="newsletter-email"
        type="email"
        name="email"
        placeholder={ui.newsletter.placeholder}
        autocomplete="email"
        required
      />
      <button class="btn btn--primary" type="submit">
        {ui.newsletter.subscribe}
      </button>
    </form>
  )
}
