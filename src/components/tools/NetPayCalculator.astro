---
import { getUi } from '../../i18n/ui/index.ts';
import ResultPanel from '../ResultPanel.astro';
import ResultChart from '../ResultChart.astro';
import AdSlot from '../AdSlot.astro';
import type { Locale } from '../../i18n/locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const copy = ui.tool['net-pay'];
---

<div>
  <form class="card" id="net-pay-form" novalidate>
    <div class="input-group">
      <label class="field" for="np-gross">
        <span class="field__label">{copy.fields.grossPay}</span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="np-gross" type="number"
            inputmode="decimal" step="100" min="0" value="5000" />
        </span>
      </label>
      <label class="field" for="np-period">
        <span class="field__label">{copy.fields.payPeriod}</span>
        <span class="field__control">
          <select class="input" id="np-period">
            <option value="year">{copy.terms.payPeriods.year}</option>
            <option value="month" selected>{copy.terms.payPeriods.month}</option>
            <option value="week">{copy.terms.payPeriods.week}</option>
            <option value="day">{copy.terms.payPeriods.day}</option>
            <option value="hour">{copy.terms.payPeriods.hour}</option>
          </select>
        </span>
      </label>
    </div>

    <div class="input-group">
      <label class="field" for="np-status">
        <span class="field__label">{copy.fields.filingStatus}</span>
        <span class="field__control">
          <select class="input" id="np-status">
            <option value="single" selected>{copy.terms.filingStatuses.single}</option>
            <option value="married">{copy.terms.filingStatuses.married}</option>
            <option value="head-of-household">{copy.terms.filingStatuses.head}</option>
          </select>
        </span>
      </label>
      <label class="field" for="np-state-rate">
        <span class="field__label">
          {copy.fields.stateRate}
          <span class="field__hint">{copy.fields.stateRateHint}</span>
        </span>
        <span class="field__control">
          <input class="input" id="np-state-rate" type="number" inputmode="decimal"
            step="0.1" min="0" max="20" value="0" />
          <span class="field__suffix" aria-hidden="true">%</span>
        </span>
      </label>
    </div>

    <label class="field" for="np-retirement">
      <span class="field__label">
        {copy.fields.retirementContribution}
        <span class="field__hint">{copy.fields.retirementHint}</span>
      </span>
      <span class="field__control">
        <span class="field__prefix" aria-hidden="true">$</span>
        <input class="input input--prefixed" id="np-retirement" type="number"
          inputmode="decimal" step="100" min="0" value="0" />
      </span>
    </label>

    <label class="field" for="np-health">
      <span class="field__label">
        {copy.fields.healthContribution}
        <span class="field__hint">{copy.fields.healthHint}</span>
      </span>
      <span class="field__control">
        <span class="field__prefix" aria-hidden="true">$</span>
        <input class="input input--prefixed" id="np-health" type="number"
          inputmode="decimal" step="100" min="0" value="0" />
      </span>
    </label>

    <p class="field__note" id="np-negative-note" role="status" hidden>
      {copy.result.negativeNote}
    </p>
  </form>
</div>

<div class="tool-panel">
  <ResultPanel
    headlineId="np-net"
    headlineLabel={copy.result.headlineLabel}
    headline="—"
    stats={[
      { id: 'np-gross-out', label: copy.result.annualGross, value: '—' },
      { id: 'np-federal', label: copy.result.federalTax, value: '—' },
      { id: 'np-ss', label: copy.result.socialSecurity, value: '—' },
      { id: 'np-medicare', label: copy.result.medicare, value: '—' },
      { id: 'np-additional', label: copy.result.additionalMedicare, value: '—' },
      { id: 'np-state', label: copy.result.stateTax, value: '—' },
      { id: 'np-total', label: copy.result.totalTax, value: '—' },
      { id: 'np-month', label: copy.result.netPerMonth, value: '—' },
      { id: 'np-rate', label: copy.result.effectiveRate, value: '—' },
    ]}
    note={copy.result.note}
  />
  <ResultChart
    chartId="net-pay-chart"
    title={copy.chart?.title}
    note={copy.chart?.note}
    emptyText={ui.chart?.empty}
    xAxis={copy.chart?.xAxis}
    yearsLabel={ui.chart?.years}
    monthsLabel={ui.chart?.months}
    startLabel={ui.chart?.start}
    endLabel={ui.chart?.end}
    series={copy.chart?.series}
  />
  <p class="muted-block" style="margin-top: var(--space-4);">
    {copy.resultNote}
  </p>
  <AdSlot placement="result" />
</div>

<script>
  import { computeNetPay, type PayPeriod } from '../../lib/calc/netPay.ts';
  import type { FilingStatus } from '../../lib/calc/tax.ts';
  import { formatCurrency, formatPercent } from '../../lib/calc/money.ts';
  import { numberValue, selectValue, setText } from '../../lib/client/dom.ts';
  import { renderChart } from '../../lib/client/chartView.ts';

  const ids = ['np-gross', 'np-period', 'np-status', 'np-state-rate', 'np-retirement', 'np-health'];

  function recalculate(): void {
    const grossPay = Math.max(0, numberValue('np-gross'));
    const period = selectValue('np-period', 'month') as PayPeriod;
    const filingStatus = selectValue('np-status', 'single') as FilingStatus;
    const stateRatePercent = Math.max(0, numberValue('np-state-rate'));
    const retirementContributionAnnual = Math.max(0, numberValue('np-retirement'));
    const healthAccountDeductionsAnnual = Math.max(0, numberValue('np-health'));

    const result = computeNetPay({
      grossPay,
      period,
      filingStatus,
      stateRatePercent,
      retirementContributionAnnual,
      healthAccountDeductionsAnnual,
    });

    setText('np-net', formatCurrency(result.netPerPeriod));
    setText('np-gross-out', formatCurrency(result.annualGross));
    setText('np-federal', formatCurrency(result.federalTax));
    setText('np-ss', formatCurrency(result.socialSecurity));
    setText('np-medicare', formatCurrency(result.medicare));
    setText('np-additional', formatCurrency(result.additionalMedicare));
    setText('np-state', formatCurrency(result.stateTax));
    setText('np-total', formatCurrency(result.totalTax));
    setText('np-month', formatCurrency(result.netPerMonth));
    setText('np-rate', formatPercent(result.effectiveTaxRate));

    /*
     * A contribution as large as the whole pay leaves nothing over the
     * payroll taxes, so the take-home figure comes out below zero. The
     * arithmetic is right, so the note explains it rather than the figure
     * being quietly replaced with a nicer one.
     */
    const note = document.getElementById('np-negative-note');
    if (note) note.hidden = result.annualNet >= 0;

    /*
     * One bar for the year: the take-home pay and the parts taken out of
     * it. The two Medicare taxes are one figure here, because the panel
     * beside it breaks them apart and the bar cannot.
     */
    renderChart('net-pay-chart', {
      kind: 'bar',
      series: [
        { key: 'net', values: [result.annualNet] },
        { key: 'federal', values: [result.federalTax] },
        { key: 'socialSecurity', values: [result.socialSecurity] },
        { key: 'medicare', values: [result.medicare + result.additionalMedicare] },
        { key: 'state', values: [result.stateTax] },
      ],
    });
  }

  for (const id of ids) {
    document.getElementById(id)?.addEventListener('input', recalculate);
    document.getElementById(id)?.addEventListener('change', recalculate);
  }

  recalculate();
</script>
