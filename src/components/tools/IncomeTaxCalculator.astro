---
import { getUi } from '../../i18n/ui/index.ts';
import ResultPanel from '../ResultPanel.astro';
import ResultChart from '../ResultChart.astro';
import AdSlot from '../AdSlot.astro';
import { stateList } from '../../lib/calc/stateTax.ts';
import type { Locale } from '../../i18n/locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const copy = ui.tool['income-tax'];
const states = stateList();
---

<div>
  <form class="card" id="income-tax-form" novalidate
    data-state-detected={copy.script.stateDetected}
    data-detected-from-ip={ui.ui.detectedFromIp}>
    <label class="field" for="it-gross">
      <span class="field__label">{copy.fields.grossIncome}</span>
      <span class="field__control">
        <span class="field__prefix" aria-hidden="true">$</span>
        <input class="input input--prefixed" id="it-gross" type="number"
          inputmode="decimal" step="1000" min="0" value="85000" />
      </span>
    </label>

    <div class="input-group">
      <label class="field" for="it-status">
        <span class="field__label">{copy.fields.filingStatus}</span>
        <span class="field__control">
          <select class="input" id="it-status">
            <option value="single" selected>{copy.terms.filingStatuses.single}</option>
            <option value="married">{copy.terms.filingStatuses.married}</option>
            <option value="head-of-household">{copy.terms.filingStatuses.head}</option>
          </select>
        </span>
      </label>
      <label class="field" for="it-itemised">
        <span class="field__label">{copy.fields.itemisedDeduction}</span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="it-itemised" type="number"
            inputmode="decimal" step="100" min="0" value="0" />
        </span>
      </label>
    </div>

    <div class="input-group">
      <div class="field">
        <label class="field__label" for="it-state">
          {copy.fields.state}
          <span class="field__hint">{copy.fields.stateHint}</span>
        </label>
        <span class="field__control">
          <select class="input" id="it-state">
            <option value="" selected>{copy.fields.stateNone}</option>
            {states.map((state) => (
              <option value={state.code}>{state.name}</option>
            ))}
          </select>
        </span>
        <p class="field__note" id="it-state-note" role="status" hidden></p>
      </div>
      <label class="field" for="it-children">
        <span class="field__label">
          {copy.fields.children}
          <span class="field__hint">{copy.fields.childrenHint}</span>
        </span>
        <span class="field__control">
          <input class="input" id="it-children" type="number" inputmode="numeric"
            step="1" min="0" max="12" value="0" />
        </span>
      </label>
    </div>

    <div class="input-group">
      <label class="field" for="it-pretax">
        <span class="field__label">
          {copy.fields.preTax}
          <span class="field__hint">{copy.fields.preTaxHint}</span>
        </span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="it-pretax" type="number"
            inputmode="decimal" step="100" min="0" value="0" />
        </span>
      </label>
      <div class="field">
        <label class="field__label" for="it-state-tax">
          {copy.fields.stateTaxOverride}
          <span class="field__hint">{copy.fields.stateTaxOverrideHint}</span>
        </label>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="it-state-tax" type="number"
            inputmode="decimal" step="100" min="0" value="" />
        </span>
      </div>
    </div>

    <button type="button" class="btn" id="it-use-standard" style="margin-top: var(--space-5);">
      {copy.fields.useStandard}
    </button>
  </form>
</div>

<div class="tool-panel">
  <ResultPanel
    headlineId="it-tax"
    headlineLabel={copy.result.headlineLabel}
    headline="—"
    stats={[
      { id: 'it-taxable', label: copy.result.taxableIncome, value: '—' },
      { id: 'it-deduction', label: copy.result.deductionApplied, value: '—' },
      { id: 'it-standard', label: copy.result.standardDeduction, value: '—' },
      { id: 'it-itemised-out', label: copy.result.itemisedDeduction, value: '—' },
      { id: 'it-state-taxable', label: copy.result.stateTaxableIncome, value: '—' },
      { id: 'it-state-credits', label: copy.result.stateCredits, value: '—' },
      { id: 'it-state-tax-out', label: copy.result.stateTax, value: '—' },
      { id: 'it-total', label: copy.result.totalTax, value: '—' },
      { id: 'it-effective', label: copy.result.effectiveRate, value: '—' },
      { id: 'it-marginal', label: copy.result.marginalRate, value: '—' },
      { id: 'it-after', label: copy.result.afterTax, value: '—' },
    ]}
    note={copy.result.note}
  />
  <ResultChart
    chartId="income-tax-chart"
    title={copy.chart?.title}
    note={copy.chart?.note}
    emptyText={ui.chart?.empty}
    xAxis={copy.chart?.xAxis}
    yearsLabel={ui.chart?.years}
    monthsLabel={ui.chart?.months}
    startLabel={ui.chart?.start}
    endLabel={ui.chart?.end}
    series={copy.chart?.series}
  />
  <p class="muted-block" style="margin-top: var(--space-4);">
    {copy.resultNote}
  </p>
  <AdSlot placement="result" />
</div>

<script>
  import { computeIncomeTax, standardDeduction } from '../../lib/calc/tax.ts';
  import type { FilingStatus } from '../../lib/calc/tax.ts';
  import { computeStateTax } from '../../lib/calc/stateTax.ts';
  import { formatCurrency, formatPercent } from '../../lib/calc/money.ts';
  import { numberValue, selectValue, setText } from '../../lib/client/dom.ts';
  import { renderChart } from '../../lib/client/chartView.ts';
  import { detectState, type DetectedState } from '../../lib/client/statePrefill.ts';
  import { fillTemplate } from '../../lib/client/text.ts';

  const ids = [
    'it-gross',
    'it-status',
    'it-itemised',
    'it-pretax',
    'it-state',
    'it-children',
    'it-state-tax',
  ];

  /*
    The state the request came from, when the network can work it out. It is
    a default: the reader can pick another state, and from that moment the
    picker is theirs.
  */
  let detected: DetectedState | null = null;
  let stateEdited = false;

  function stateNoteText(): string {
    const copy = document.getElementById('income-tax-form')?.dataset;
    if (!detected || !copy) return '';

    const disclosure = copy.detectedFromIp ?? '';

    /*
      A state the reader picked is theirs, so the sentence that says the
      field was filled in no longer applies. The disclosure stays: the state
      was read from the request either way.
    */
    if (stateEdited) return disclosure;

    const template = copy.stateDetected;
    if (!template) return disclosure;

    return `${fillTemplate(template, { state: detected.name })} ${disclosure}`.trim();
  }

  function showStateNote(): void {
    const note = document.getElementById('it-state-note');
    if (!note) return;
    const text = stateNoteText();
    note.textContent = text;
    note.hidden = text.length === 0;
  }

  /** The figure the reader typed, when there is one. */
  function overrideValue(): number | null {
    const input = document.getElementById('it-state-tax') as HTMLInputElement | null;
    if (!input || input.value.trim() === '') return null;
    const parsed = Number.parseFloat(input.value.replace(/[^0-9.]/g, ''));
    if (!Number.isFinite(parsed)) return null;
    return Math.max(0, parsed);
  }

  function recalculate(): void {
    const grossIncome = Math.max(0, numberValue('it-gross'));
    const filingStatus = selectValue('it-status', 'single') as FilingStatus;
    const itemisedDeduction = Math.max(0, numberValue('it-itemised'));
    const preTaxDeductions = Math.max(0, numberValue('it-pretax'));
    const children = Math.max(0, Math.trunc(numberValue('it-children')));
    const stateCode = selectValue('it-state', '');
    const override = overrideValue();

    const result = computeIncomeTax({
      grossIncome,
      filingStatus,
      preTaxDeductions,
      itemisedDeduction,
      stateRatePercent: 0,
    });

    /*
      The state tax is worked out from the state's own brackets, standard
      deduction, exemption and credits. The figure the reader typed, if
      there is one, is theirs and replaces the calculation.
    */
    const adjustedGrossIncome = Math.max(0, grossIncome - preTaxDeductions);
    const state = computeStateTax({
      stateCode,
      filingStatus,
      adjustedGrossIncome,
      children,
    });

    const stateTax = override !== null ? override : (state?.tax ?? 0);
    const totalTax = result.federalTax + stateTax;
    const afterTaxIncome = Math.max(0, grossIncome - preTaxDeductions - totalTax);
    const effectiveRate = grossIncome > 0 ? (totalTax / grossIncome) * 100 : 0;

    setText('it-tax', formatCurrency(result.federalTax));
    setText('it-taxable', formatCurrency(result.taxableIncome));
    setText('it-deduction', formatCurrency(result.deduction));
    setText('it-standard', formatCurrency(standardDeduction(filingStatus)));
    setText('it-itemised-out', formatCurrency(itemisedDeduction));
    setText('it-state-taxable', formatCurrency(state?.taxableIncome ?? 0));
    setText('it-state-credits', formatCurrency(state?.credits ?? 0));
    setText('it-state-tax-out', formatCurrency(stateTax));
    setText('it-total', formatCurrency(totalTax));
    setText('it-effective', formatPercent(effectiveRate));
    setText('it-marginal', formatPercent(result.marginalRate * 100));
    setText('it-after', formatCurrency(afterTaxIncome));

    /*
     * One bar for the year: the income that stays and the tax that goes.
     */
    renderChart('income-tax-chart', {
      kind: 'bar',
      series: [
        { key: 'afterTax', values: [afterTaxIncome] },
        { key: 'federal', values: [result.federalTax] },
        { key: 'state', values: [stateTax] },
      ],
    });
  }

  /*
    A state the reader picks is theirs. The listener is registered before
    the recalculation one, so the flag is already set when the
    recalculation runs.
  */
  document.getElementById('it-state')?.addEventListener('change', () => {
    stateEdited = true;
    showStateNote();
  });

  for (const id of ids) {
    document.getElementById(id)?.addEventListener('input', recalculate);
    document.getElementById(id)?.addEventListener('change', recalculate);
  }

  document.getElementById('it-use-standard')?.addEventListener('click', () => {
    const input = document.getElementById('it-itemised') as HTMLInputElement | null;
    if (input) input.value = '0';
    recalculate();
  });

  recalculate();

  /*
    The state comes from the edge, so it arrives after the first render. The
    page works without it, and so does the reader who is not in the United
    States or whose request the network cannot place.
  */
  detectState().then((state) => {
    if (!state) return;
    detected = state;

    const picker = document.getElementById('it-state') as HTMLSelectElement | null;
    if (picker && !stateEdited) picker.value = state.code;

    showStateNote();
    recalculate();
  });
</script>
