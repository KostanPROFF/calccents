---
import { getSite } from '../config/site.ts';
import { getUi } from '../i18n/ui/index.ts';
import { alternates, DEFAULT_LOCALE, LOCALE_META, localePath, type Locale } from '../i18n/locales.ts';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path of the current page, including the locale prefix. */
  path: string;
  /** The language this page is written in. */
  locale: Locale;
  /** Structured data objects rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  locale,
  jsonLd = [],
  ogType = 'website',
  noindex = false,
} = Astro.props;

const site = getSite(locale);
const ui = getUi(locale);

const canonical = new URL(path, site.origin).toString();
const fullTitle =
  path === '/' ? `${site.name} — ${site.tagline}` : `${title} | ${site.name}`;

/**
 * The same page in the other languages.
 *
 * A translated page that does not say which other translations exist is a
 * page that gets indexed twice and read in the wrong language, so every
 * page carries the alternates. `x-default` points at the English version,
 * which is the one written first and the one the other two were made from.
 */
const alternateLinks = alternates(path);

/**
 * The site and its author, described on every page.
 *
 * A one-person site has to be explicit about who is behind it: the same
 * structured data that names a publisher on a large site names the person
 * here, with a link to the profile that can be checked.
 */
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.origin,
  description: site.description,
  foundingDate: site.founded,
  email: site.email,
  logo: new URL('/favicon.svg', site.origin).toString(),
  sameAs: [site.repository, ...site.author.links.map((link) => link.href)],
};

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author.name,
  jobTitle: site.author.role,
  description: site.author.bio,
  url: new URL(localePath(locale, '/editorial-team/'), site.origin).toString(),
  worksFor: { '@type': 'Organization', name: site.name },
  sameAs: site.author.links.map((link) => link.href),
};

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      alternateLinks.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.locale}
          href={new URL(alternate.href, site.origin).toString()}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(
        alternateLinks.find((link) => link.locale === DEFAULT_LOCALE)?.href ?? '/',
        site.origin,
      ).toString()}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.ogLocale} />
    {
      alternateLinks
        .filter((alternate) => alternate.locale !== locale)
        .map((alternate) => (
          <meta
            property="og:locale:alternate"
            content={LOCALE_META[alternate.locale].ogLocale}
          />
        ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!--
      The AdSense ownership tag.

      This tells Google which publisher account this site belongs to, which
      is how the application is reviewed. It carries no ad code and makes no
      request to anyone: the loader script and the ad units are gated on
      environment variables and stay off until the account is approved.
    -->
    <meta name="google-adsense-account" content={site.adsensePublisherId} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!--
      The theme is chosen before the first paint, so a reader never sees a
      flash of the wrong colours. A stored choice wins; otherwise the
      operating system decides.
    -->
    <script is:inline>
      (function () {
        var theme = 'dark';
        try {
          var stored = localStorage.getItem('calccents-theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch (error) {
          theme = 'dark';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    {
      [...jsonLd, organization, person].map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    {
      gaId && (
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
        />
      )
    }
    {
      gaId && (
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.ui.skipToContent}</a>
    <Nav currentPath={Astro.url.pathname} locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    {
      adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
  </body>
</html>
