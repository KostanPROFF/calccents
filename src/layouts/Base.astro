---
import { SITE } from '../config/site.ts';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path of the current page, used for the canonical URL. */
  path: string;
  /** Structured data objects rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  jsonLd = [],
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE.origin).toString();
const fullTitle = path === '/' ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;

/**
 * The site and its author, described on every page.
 *
 * A one-person site has to be explicit about who is behind it: the same
 * structured data that names a publisher on a large site names the person
 * here, with a link to the profile that can be checked.
 */
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.origin,
  description: SITE.description,
  foundingDate: SITE.founded,
  email: SITE.email,
  logo: new URL('/favicon.svg', SITE.origin).toString(),
  sameAs: [SITE.repository, ...SITE.author.links.map((link) => link.href)],
};

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author.name,
  jobTitle: SITE.author.role,
  description: SITE.author.bio,
  url: new URL('/editorial-team/', SITE.origin).toString(),
  worksFor: { '@type': 'Organization', name: SITE.name },
  sameAs: SITE.author.links.map((link) => link.href),
};

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!--
      The theme is chosen before the first paint, so a reader never sees a
      flash of the wrong colours. A stored choice wins; otherwise the
      operating system decides.
    -->
    <script is:inline>
      (function () {
        var theme = 'dark';
        try {
          var stored = localStorage.getItem('calccents-theme');
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          }
        } catch (error) {
          theme = 'dark';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    {
      [...jsonLd, organization, person].map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    {
      gaId && (
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
        />
      )
    }
    {
      gaId && (
        <script is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {
      adsenseClient && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
  </body>
</html>
