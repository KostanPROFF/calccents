---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { TOOLS } from '../../config/tools.ts';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const countFor = (slug: string) =>
  guides.filter((guide) => guide.data.relatedTools.includes(slug)).length;
---

<Base
  title="Free Financial Calculators"
  description="Three free calculators that show the arithmetic behind a mortgage payment, a rent versus buy comparison and a compound interest projection."
  path="/tools/"
>
  <div class="container">
    <div class="page-head">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Tools</span>
      </nav>
      <h1>Free financial calculators</h1>
      <p class="page-head__lede">
        Each calculator shows the formula it uses, lists the assumptions behind
        the result, and states plainly what it does not do. Nothing here asks
        for an email address, and nothing here asks you to sign up for
        anything.
      </p>
    </div>

    <div class="grid grid--2">
      {
        TOOLS.map((tool) => (
          <a class="tile" href={`/tools/${tool.slug}/`}>
            <span class="badge">{tool.category}</span>
            <span class="tile__title">{tool.name}</span>
            <span class="tile__text">{tool.short}</span>
            <span class="tile__meta">
              {countFor(tool.slug)} guide{countFor(tool.slug) === 1 ? '' : 's'} · Calculate →
            </span>
          </a>
        ))
      }
    </div>

    <AdSlot placement="in-article" />

    <section class="section-sm">
      <h2>What these tools are</h2>
      <div class="prose" style="margin-top: var(--space-4);">
        <p>
          These are arithmetic tools. They take the numbers you supply, apply a
          published formula, and hand the result back with the working attached.
          A mortgage calculator here does not know your credit score, your
          income, or which lender is offering what this week, and it does not
          try to guess.
        </p>
        <p>
          The reason is simple: a number you can check is worth more than a
          number someone else picked for you. Every tool here shows the formula
          in symbols, links to the primary sources behind the method, and
          carries a review date so you can see when it was last checked.
        </p>
      </div>
    </section>

    <AdSlot placement="footer" />
  </div>
</Base>
