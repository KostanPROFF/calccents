---
import ToolShell from '../../components/ToolShell.astro';
import ResultPanel from '../../components/ResultPanel.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getTool } from '../../config/tools.ts';

const tool = getTool('rent-vs-buy');

const sources = [
  {
    label: 'CFPB — Housing costs, renting and owning',
    url: 'https://www.consumerfinance.gov/consumer-tools/mortgages/',
  },
  {
    label: 'HUD — Housing costs, property taxes and insurance guidance',
    url: 'https://www.hud.gov/helping_american_homeowners',
  },
  {
    label: 'BLS — Consumer Price Index (inflation, for the appreciation note)',
    url: 'https://www.bls.gov/cpi/',
  },
  {
    label: 'FRED — Home price index series used for long-run price movement',
    url: 'https://fred.stlouisfed.org/series/HPINUS',
  },
];

const limits = [
  'It does not say which option is better for you. The two paths are compared on the numbers you supply and the crossover month is reported, nothing more.',
  'It does not model the tax treatment of a sale, the mortgage interest deduction, or the depreciation of a property over time.',
  'It does not price a specific loan. The mortgage rate you enter is the rate used; the page carries no live quotes and no lender information.',
  'It does not forecast home prices. The annual change in value you enter is applied month by month for the whole horizon, in both directions if you enter a negative number.',
];

const faq = [
  {
    q: 'What does the crossover month mean?',
    a: 'It is the first month where the net cost of owning — the cash you have paid, minus the equity you have built — is lower than the cash you would have paid in rent over the same period. Before that point renting has cost less in cash terms. After it, owning has cost less once equity is counted.',
  },
  {
    q: 'Why does the calculation include a maintenance allowance?',
    a: 'A home costs money to keep in repair regardless of whether a mortgage is attached to it, and that cost does not appear on any closing statement. The calculator applies it as a percentage of the purchase price each year, and the percentage is an input you set.',
  },
  {
    q: 'What happens to the home value in the calculation?',
    a: 'It is grown or shrunk every month at the annual rate you enter, then compared with the remaining loan balance to give the equity figure. A negative rate models a falling market; a zero rate holds the price flat.',
  },
  {
    q: 'Are selling costs included?',
    a: 'Selling costs are shown separately at the end of the horizon, as a percentage of the final home value. They are not deducted month by month, because you do not pay them until you sell.',
  },
  {
    q: 'What is the difference between total rent and net cost of ownership?',
    a: 'Total rent is simply what you pay in rent each month multiplied by the number of months. Net cost of ownership is what you pay in mortgage, tax, insurance, HOA and maintenance, plus the upfront outlay, minus the equity you have accumulated. The second figure can be negative, which means you have built more equity than you have paid out.',
  },
  {
    q: 'Does this include the tax consequences of selling a home?',
    a: 'No. Any gain on the sale, and any exclusion that applies to it, is outside the scope of this tool. The comparison here is a cash and equity comparison, not a tax comparison.',
  },
];

const relatedGuides = [
  { slug: 'rent-vs-buy-calculator-explained', title: 'Rent vs buy calculator explained' },
  { slug: 'rent-vs-buy-common-mistakes', title: 'Common mistakes in rent versus buy comparisons' },
  { slug: 'estimating-property-tax-and-home-insurance', title: 'Estimating property tax and home insurance' },
  { slug: 'down-payment-and-closing-costs-explained', title: 'Down payment and closing costs explained' },
  { slug: 'monthly-payment-vs-total-cost-mortgage', title: 'Monthly payment vs total cost of a mortgage' },
];
---

<ToolShell
  tool={tool}
  faq={faq}
  sources={sources}
  limits={limits}
  reviewedOn="20 October 2026"
  relatedGuides={relatedGuides}
  methodNote="The comparison is cash outflow and equity. It deliberately produces no verdict — the crossover month is a fact about the numbers you entered, not a recommendation."
>
  <form class="card" id="rent-buy-form" novalidate slot="calculator">
    <p class="eyebrow" style="color: var(--text-muted);">The home</p>
    <div class="input-group">
      <label class="field" for="rb-home-price">
        <span class="field__label">Purchase price</span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="rb-home-price" type="number"
            inputmode="decimal" step="5000" min="0" value="450000" />
        </span>
      </label>
      <label class="field" for="rb-down-percent">
        <span class="field__label">
          Down payment
          <span class="field__hint">percent of price</span>
        </span>
        <span class="field__control">
          <input class="input" id="rb-down-percent" type="number" inputmode="decimal"
            step="0.5" min="0" max="100" value="20" />
          <span class="field__suffix" aria-hidden="true">%</span>
        </span>
      </label>
    </div>

    <div class="input-group">
      <label class="field" for="rb-rate">
        <span class="field__label">
          Mortgage rate
          <span class="field__hint">annual, fixed</span>
        </span>
        <span class="field__control">
          <input class="input" id="rb-rate" type="number" inputmode="decimal" step="0.01"
            min="0" max="20" value="6.5" />
          <span class="field__suffix" aria-hidden="true">%</span>
        </span>
      </label>
      <label class="field" for="rb-term">
        <span class="field__label">Loan term</span>
        <span class="field__control">
          <select class="input" id="rb-term">
            <option value="30" selected>30 years</option>
            <option value="20">20 years</option>
            <option value="15">15 years</option>
          </select>
        </span>
      </label>
    </div>

    <p class="eyebrow" style="color: var(--text-muted); margin-top: var(--space-6);">
      The rent
    </p>
    <div class="input-group">
      <label class="field" for="rb-rent">
        <span class="field__label">Monthly rent</span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="rb-rent" type="number"
            inputmode="decimal" step="25" min="0" value="2400" />
        </span>
      </label>
      <label class="field" for="rb-renters-insurance">
        <span class="field__label">
          Renter's insurance
          <span class="field__hint">per month</span>
        </span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="rb-renters-insurance" type="number"
            inputmode="decimal" step="5" min="0" value="20" />
        </span>
      </label>
    </div>

    <p class="eyebrow" style="color: var(--text-muted); margin-top: var(--space-6);">
      Running costs
    </p>
    <div class="input-group">
      <label class="field" for="rb-tax-percent">
        <span class="field__label">
          Property tax
          <span class="field__hint">% of price per year</span>
        </span>
        <span class="field__control">
          <input class="input" id="rb-tax-percent" type="number" inputmode="decimal"
            step="0.01" min="0" max="10" value="1.1" />
          <span class="field__suffix" aria-hidden="true">%</span>
        </span>
      </label>
      <label class="field" for="rb-insurance">
        <span class="field__label">
          Home insurance
          <span class="field__hint">per year</span>
        </span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="rb-insurance" type="number"
            inputmode="decimal" step="50" min="0" value="1800" />
        </span>
      </label>
    </div>

    <div class="input-group">
      <label class="field" for="rb-hoa">
        <span class="field__label">
          HOA or condo fee
          <span class="field__hint">per month</span>
        </span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="rb-hoa" type="number" inputmode="decimal"
            step="25" min="0" value="0" />
        </span>
      </label>
      <label class="field" for="rb-maintenance">
        <span class="field__label">
          Maintenance
          <span class="field__hint">% of price per year</span>
        </span>
        <span class="field__control">
          <input class="input" id="rb-maintenance" type="number" inputmode="decimal"
            step="0.1" min="0" max="10" value="1" />
          <span class="field__suffix" aria-hidden="true">%</span>
        </span>
      </label>
    </div>

    <p class="eyebrow" style="color: var(--text-muted); margin-top: var(--space-6);">
      Assumptions
    </p>
    <div class="input-group">
      <label class="field" for="rb-appreciation">
        <span class="field__label">
          Annual change in value
          <span class="field__hint">negative models a fall</span>
        </span>
        <span class="field__control">
          <input class="input" id="rb-appreciation" type="number" inputmode="decimal"
            step="0.1" min="-20" max="20" value="3" />
          <span class="field__suffix" aria-hidden="true">%</span>
        </span>
      </label>
      <label class="field" for="rb-horizon">
        <span class="field__label">Compare over</span>
        <span class="field__control">
          <select class="input" id="rb-horizon">
            <option value="5" selected>5 years</option>
            <option value="10">10 years</option>
            <option value="15">15 years</option>
            <option value="30">30 years</option>
          </select>
        </span>
      </label>
    </div>

    <div class="input-group">
      <label class="field" for="rb-closing">
        <span class="field__label">
          Closing costs
          <span class="field__hint">% of price, once</span>
        </span>
        <span class="field__control">
          <input class="input" id="rb-closing" type="number" inputmode="decimal"
            step="0.1" min="0" max="15" value="2.5" />
          <span class="field__suffix" aria-hidden="true">%</span>
        </span>
      </label>
      <label class="field" for="rb-selling">
        <span class="field__label">
          Selling costs
          <span class="field__hint">% of final value</span>
        </span>
        <span class="field__control">
          <input class="input" id="rb-selling" type="number" inputmode="decimal"
            step="0.1" min="0" max="15" value="6" />
          <span class="field__suffix" aria-hidden="true">%</span>
        </span>
      </label>
    </div>
  </form>

  <div slot="result">
    <ResultPanel
      headlineId="rb-headline"
      headlineLabel="Monthly difference (owning minus renting)"
      headline="—"
      stats={[
        { id: 'rb-out-rent', label: 'Monthly rent', value: '—' },
        { id: 'rb-own', label: 'Monthly ownership', value: '—' },
        { id: 'rb-upfront', label: 'Upfront outlay', value: '—' },
        { id: 'rb-equity', label: 'Equity built', value: '—' },
        { id: 'rb-home-value', label: 'Home value at horizon', value: '—' },
        { id: 'rb-breakeven', label: 'Crossover', value: '—' },
      ]}
      note="Ownership includes mortgage, property tax, insurance, HOA and maintenance. Equity is the home value minus the balance still owed."
    />
    <p class="muted-block" style="margin-top: var(--space-4);">
      The crossover is the first month where the net cost of owning — cash paid
      minus equity built — falls below the cash cost of renting. It is a fact
      about these numbers, not a recommendation.
    </p>
    <AdSlot placement="result" />
  </div>

  <div slot="method">
    <p>
      Each month the calculator runs two ledgers side by side. The renting
      ledger adds your rent and renter's insurance. The owning ledger adds the
      mortgage payment from the standard amortization formula, property tax,
      insurance, HOA and the maintenance allowance, plus the down payment and
      closing costs on the first month.
    </p>
    <p>
      Alongside the second ledger it tracks the home's value, grown or shrunk
      each month at the annual rate you entered, and the balance still owed on
      the loan. The difference between the two is your equity:
    </p>
    <p>
      <strong>equity = home value − remaining loan balance</strong>
    </p>
    <p>
      The net cost of owning is the cash you have paid, minus the equity you
      have built. The crossover month is the first month where that figure is
      lower than the rent you would have paid over the same period. Selling
      costs are held back and reported at the end of the horizon, because you
      do not pay them until you sell.
    </p>
  </div>
</ToolShell>

<script>
  import { compareRentAndBuy } from '../../lib/calc/rentVsBuy.ts';
  import { formatCurrency } from '../../lib/calc/money.ts';
  import { numberValue, setText } from '../../lib/client/dom.ts';

  const ids = [
    'rb-home-price',
    'rb-down-percent',
    'rb-rate',
    'rb-term',
    'rb-rent',
    'rb-renters-insurance',
    'rb-tax-percent',
    'rb-insurance',
    'rb-hoa',
    'rb-maintenance',
    'rb-appreciation',
    'rb-horizon',
    'rb-closing',
    'rb-selling',
  ];

  function recalculate(): void {
    const homePrice = Math.max(0, numberValue('rb-home-price'));
    if (homePrice <= 0) {
      for (const id of [
        'rb-headline',
        'rb-rent',
        'rb-own',
        'rb-upfront',
        'rb-equity',
        'rb-home-value',
        'rb-breakeven',
      ]) {
        setText(id, '—');
      }
      return;
    }

    const result = compareRentAndBuy({
      homePrice,
      downPaymentPercent: Math.min(100, Math.max(0, numberValue('rb-down-percent', 20))),
      mortgageRatePercent: Math.max(0, numberValue('rb-rate')),
      mortgageTermYears: Math.max(1, numberValue('rb-term', 30)),
      monthlyRent: Math.max(0, numberValue('rb-rent')),
      annualPropertyTaxPercent: Math.max(0, numberValue('rb-tax-percent')),
      annualInsurance: Math.max(0, numberValue('rb-insurance')),
      monthlyHoa: Math.max(0, numberValue('rb-hoa')),
      annualMaintenancePercent: Math.max(0, numberValue('rb-maintenance')),
      annualAppreciationPercent: numberValue('rb-appreciation'),
      sellingCostPercent: Math.max(0, numberValue('rb-selling')),
      closingCostPercent: Math.max(0, numberValue('rb-closing')),
      rentersInsuranceMonthly: Math.max(0, numberValue('rb-renters-insurance')),
      horizonYears: Math.max(1, numberValue('rb-horizon', 5)),
      startDate: new Date(),
    });

    setText('rb-headline', formatCurrency(result.monthlyDifference));
    setText('rb-out-rent', formatCurrency(result.monthlyRentTotal));
    setText('rb-own', formatCurrency(result.monthlyOwnership));
    setText('rb-upfront', formatCurrency(result.upfrontCost));
    setText('rb-equity', formatCurrency(result.equityAtHorizon));
    setText('rb-home-value', formatCurrency(result.homeValueAtHorizon));
    setText(
      'rb-breakeven',
      result.breakEvenMonth === null
        ? 'Not within the horizon'
        : `Month ${result.breakEvenMonth}`,
    );
  }

  for (const id of ids) {
    document.getElementById(id)?.addEventListener('input', recalculate);
    document.getElementById(id)?.addEventListener('change', recalculate);
  }
  recalculate();
</script>
