---
import ToolShell from '../../components/ToolShell.astro';
import ResultPanel from '../../components/ResultPanel.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getTool } from '../../config/tools.ts';

const tool = getTool('mortgage-payment');

const sources = [
  {
    label: 'CFPB — How to calculate a mortgage payment',
    url: 'https://www.consumerfinance.gov/ask-cfpb/how-do-i-calculate-my-mortgage-payment-en-144/',
  },
  {
    label: 'Freddie Mac — Primary Mortgage Market Survey (rate methodology)',
    url: 'https://www.freddiemac.com/pmms',
  },
  {
    label: 'HUD — FHA loan requirements and mortgage insurance',
    url: 'https://www.hud.gov/helping_american_homeowners',
  },
  {
    label: 'BLS — Consumer Price Index (inflation, for the real-value note)',
    url: 'https://www.bls.gov/cpi/',
  },
];

const limits = [
  'It does not check whether you qualify for a loan, and it does not look at your credit score, income, debt-to-income ratio or any lender\'s underwriting rules.',
  'It does not quote current market rates for your postcode. The interest rate you enter is the rate you use, and nothing on this page is live.',
  'It does not model private mortgage insurance, points, loan origination fees, closing costs, or the escrow timing that decides which month a tax bill lands in.',
  'It does not tell you whether to buy a home. It produces a number and the working behind it.',
];

const faq = [
  {
    q: 'What does PITI stand for?',
    a: 'Principal, Interest, Taxes and Insurance. It is the four-part monthly housing payment: the part that repays the loan, the part that pays the lender for borrowing, property tax, and homeowners insurance. This calculator shows each part separately so you can see what drives the total.',
  },
  {
    q: 'How is the monthly principal and interest payment worked out?',
    a: 'It is the standard amortization formula: M = P · r(1 + r)ⁿ / ((1 + r)ⁿ − 1), where P is the amount borrowed, r is the monthly interest rate and n is the number of monthly payments. The schedule that follows it moves interest down and principal up every month, so early payments are mostly interest.',
  },
  {
    q: 'What happens to the final payment?',
    a: 'The scheduled payment is rounded to the nearest cent, which leaves a few cents outstanding at the end of the term. The last scheduled payment is adjusted so the loan closes at exactly zero, the same way a lender adjusts a final payment.',
  },
  {
    q: 'Do extra payments shorten the loan or the payment?',
    a: 'They shorten the loan. An extra payment is applied to principal, which lowers the balance that the next month\'s interest is charged on. The scheduled payment stays the same, and the loan finishes sooner with less total interest.',
  },
  {
    q: 'Is the total interest figure affected by my tax and insurance inputs?',
    a: 'No. Total interest covers the loan only. Property tax, insurance and HOA are housing costs that continue after the loan is paid off, which is why the calculator reports total housing cost separately.',
  },
  {
    q: 'Does the calculator account for inflation?',
    a: 'No. Every figure is in the dollars you entered. A mortgage payment in 30 years is a much smaller share of income than the same payment today, and none of the numbers on this page adjust for that.',
  },
];

const relatedGuides = [
  { slug: 'mortgage-payment-calculator-explained', title: 'Mortgage payment calculator explained' },
  { slug: 'how-mortgage-amortization-works', title: 'How mortgage amortization works' },
  { slug: 'monthly-payment-vs-total-cost-mortgage', title: 'Monthly payment vs total cost of a mortgage' },
  { slug: 'extra-mortgage-payments-math', title: 'The math behind extra mortgage payments' },
  { slug: 'how-to-read-an-amortization-schedule', title: 'How to read an amortization schedule' },
];
---

<ToolShell
  tool={tool}
  faq={faq}
  sources={sources}
  limits={limits}
  reviewedOn="20 October 2026"
  relatedGuides={relatedGuides}
  methodNote="The payment formula, the amortization schedule and the way extra payments are applied are described below. Nothing on this page is a live market quote."
>
  <form class="card" id="mortgage-form" novalidate slot="calculator">
    <div class="input-group">
      <label class="field" for="home-price">
        <span class="field__label">Home price</span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="home-price" type="number"
            inputmode="decimal" step="1000" min="0" value="450000" />
        </span>
      </label>
      <label class="field" for="down-percent">
        <span class="field__label">
          Down payment
          <span class="field__hint">percent of price</span>
        </span>
        <span class="field__control">
          <input class="input" id="down-percent" type="number" inputmode="decimal"
            step="0.5" min="0" max="100" value="20" />
          <span class="field__suffix" aria-hidden="true">%</span>
        </span>
      </label>
    </div>

    <div class="input-group">
      <label class="field" for="rate">
        <span class="field__label">
          Interest rate
          <span class="field__hint">annual, fixed</span>
        </span>
        <span class="field__control">
          <input class="input" id="rate" type="number" inputmode="decimal" step="0.01"
            min="0" max="20" value="6.5" />
          <span class="field__suffix" aria-hidden="true">%</span>
        </span>
      </label>
      <label class="field" for="term-years">
        <span class="field__label">Loan term</span>
        <span class="field__control">
          <select class="input" id="term-years">
            <option value="30" selected>30 years</option>
            <option value="20">20 years</option>
            <option value="15">15 years</option>
            <option value="10">10 years</option>
          </select>
        </span>
      </label>
    </div>

    <div class="input-group">
      <label class="field" for="tax-percent">
        <span class="field__label">
          Property tax
          <span class="field__hint">% of price per year</span>
        </span>
        <span class="field__control">
          <input class="input" id="tax-percent" type="number" inputmode="decimal"
            step="0.01" min="0" max="10" value="1.1" />
          <span class="field__suffix" aria-hidden="true">%</span>
        </span>
      </label>
      <label class="field" for="insurance-annual">
        <span class="field__label">
          Home insurance
          <span class="field__hint">per year</span>
        </span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="insurance-annual" type="number"
            inputmode="decimal" step="50" min="0" value="1800" />
        </span>
      </label>
    </div>

    <div class="input-group">
      <label class="field" for="hoa-monthly">
        <span class="field__label">
          HOA or condo fee
          <span class="field__hint">per month</span>
        </span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="hoa-monthly" type="number"
            inputmode="decimal" step="25" min="0" value="0" />
        </span>
      </label>
      <label class="field" for="extra-monthly">
        <span class="field__label">
          Extra principal
          <span class="field__hint">per month</span>
        </span>
        <span class="field__control">
          <span class="field__prefix" aria-hidden="true">$</span>
          <input class="input input--prefixed" id="extra-monthly" type="number"
            inputmode="decimal" step="25" min="0" value="0" />
        </span>
      </label>
    </div>

    <label class="field" for="start-month">
      <span class="field__label">
        First payment
        <span class="field__hint">month</span>
      </span>
      <span class="field__control">
        <input class="input" id="start-month" type="month" />
      </span>
    </label>

    <details style="margin-top: var(--space-6);">
      <summary class="text-sm" style="cursor: pointer; color: var(--text-secondary);">
        See the year-by-year amortization
      </summary>
      <div class="table-wrap" style="margin-top: var(--space-4);">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Year</th>
              <th scope="col">Principal</th>
              <th scope="col">Interest</th>
              <th scope="col">Balance</th>
            </tr>
          </thead>
          <tbody id="amortization-body"></tbody>
        </table>
      </div>
    </details>
  </form>

  <div slot="result">
    <ResultPanel
      headlineId="m-payment"
      headlineLabel="Total monthly payment (PITI)"
      headline="—"
      stats={[
        { id: 'm-pi', label: 'Principal & interest', value: '—' },
        { id: 'm-tax', label: 'Property tax', value: '—' },
        { id: 'm-insurance', label: 'Insurance', value: '—' },
        { id: 'm-hoa', label: 'HOA', value: '—' },
        { id: 'm-interest', label: 'Total interest', value: '—' },
        { id: 'm-payoff', label: 'Paid off', value: '—' },
      ]}
      note="Principal, interest, property tax, insurance and HOA, using the numbers you entered."
    />
    <p class="muted-block" style="margin-top: var(--space-4);">
      Change any field and the figures update as you type. Nothing is sent
      anywhere: the arithmetic runs in this page.
    </p>
    <AdSlot placement="result" />
  </div>

  <div slot="method">
    <p>
      The scheduled monthly payment comes from the standard amortization
      formula:
    </p>
    <p>
      <strong>M = P · r(1 + r)ⁿ / ((1 + r)ⁿ − 1)</strong>
    </p>
    <p>
      <strong>P</strong> is the amount borrowed, which this page works out as
      the home price minus the down payment. <strong>r</strong> is the annual
      rate you entered divided by twelve, and <strong>n</strong> is the term in
      months. From that one figure the calculator builds a schedule month by
      month: interest is charged on the balance still outstanding at the start
      of the month, and whatever is left of the payment after that interest
      reduces the balance.
    </p>
    <p>
      The full monthly payment is the principal and interest figure plus
      property tax divided by twelve, insurance divided by twelve, and any HOA
      fee. Those three are yours to set: the calculator has no idea what your
      local assessment or your insurer charges, and it does not guess on your
      behalf.
    </p>
    <p>
      An extra monthly payment is applied to principal, so it lowers the
      balance that the next month's interest is charged on. The scheduled
      payment does not change, the loan finishes earlier, and the total
      interest falls.
    </p>
  </div>
</ToolShell>

<script>
  import { buildAmortization } from '../../lib/calc/mortgage.ts';
  import { formatCurrency, formatMonthYear, formatNumber } from '../../lib/calc/money.ts';
  import { currentMonthValue, monthValue, numberValue, setText } from '../../lib/client/dom.ts';

  const startInput = document.getElementById('start-month') as HTMLInputElement | null;
  if (startInput && !startInput.value) startInput.value = currentMonthValue();

  const ids = [
    'home-price',
    'down-percent',
    'rate',
    'term-years',
    'tax-percent',
    'insurance-annual',
    'hoa-monthly',
    'extra-monthly',
  ];

  function recalculate(): void {
    const homePrice = Math.max(0, numberValue('home-price'));
    const downPercent = Math.min(100, Math.max(0, numberValue('down-percent', 20)));
    const rate = Math.max(0, numberValue('rate'));
    const termYears = Math.max(1, numberValue('term-years', 30));
    const taxPercent = Math.max(0, numberValue('tax-percent'));
    const insuranceAnnual = Math.max(0, numberValue('insurance-annual'));
    const hoaMonthly = Math.max(0, numberValue('hoa-monthly'));
    const extraMonthly = Math.max(0, numberValue('extra-monthly'));
    const startDate = monthValue('start-month', new Date());

    if (homePrice <= 0) {
      setText('m-payment', '—');
      for (const id of ['m-pi', 'm-tax', 'm-insurance', 'm-hoa', 'm-interest', 'm-payoff']) {
        setText(id, '—');
      }
      return;
    }

    const downPayment = homePrice * (downPercent / 100);
    const loanAmount = homePrice - downPayment;
    const propertyTaxAnnual = homePrice * (taxPercent / 100);

    const result = buildAmortization({
      principal: loanAmount,
      annualRatePercent: rate,
      termYears,
      propertyTaxAnnual,
      homeownersInsuranceAnnual: insuranceAnnual,
      hoaMonthly,
      extraMonthlyPayment: extraMonthly,
      startDate,
    });

    setText('m-payment', formatCurrency(result.monthlyPiti));
    setText('m-pi', formatCurrency(result.monthlyPrincipalAndInterest));
    setText('m-tax', formatCurrency(propertyTaxAnnual / 12));
    setText('m-insurance', formatCurrency(insuranceAnnual / 12));
    setText('m-hoa', formatCurrency(hoaMonthly));
    setText('m-interest', formatCurrency(result.totalInterest));
    setText('m-payoff', formatMonthYear(result.payoffDate));

    const body = document.getElementById('amortization-body');
    if (body) {
      body.innerHTML = result.yearly
        .map(
          (row) =>
            `<tr><td>${row.year}</td><td>${formatCurrency(row.principalPaid)}</td>` +
            `<td>${formatCurrency(row.interestPaid)}</td>` +
            `<td>${formatNumber(row.yearEndBalance)}</td></tr>`,
        )
        .join('');
    }
  }

  for (const id of ids) {
    document.getElementById(id)?.addEventListener('input', recalculate);
    document.getElementById(id)?.addEventListener('change', recalculate);
  }
  startInput?.addEventListener('input', recalculate);
  recalculate();
</script>
