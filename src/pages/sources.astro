---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';

const sources = [
  {
    label: 'Consumer Financial Protection Bureau (CFPB) — mortgages, consumer credit',
    url: 'https://www.consumerfinance.gov/',
  },
  {
    label: 'Internal Revenue Service (IRS) — tax brackets, inflation adjustments, retirement rules',
    url: 'https://www.irs.gov/',
  },
  {
    label: 'Freddie Mac — Primary Mortgage Market Survey',
    url: 'https://www.freddiemac.com/pmms',
  },
  {
    label: 'Fannie Mae — research and market commentary',
    url: 'https://www.fanniemae.com/research-and-insights',
  },
  {
    label: 'Department of Housing and Urban Development (HUD) — FHA, HECM, fair housing',
    url: 'https://www.hud.gov/',
  },
  {
    label: 'Bureau of Labor Statistics (BLS) — Consumer Price Index',
    url: 'https://www.bls.gov/cpi/',
  },
  {
    label: 'Federal Reserve Board — interest rate data (H.15)',
    url: 'https://www.federalreserve.gov/releases/h15/',
  },
  {
    label: 'Securities and Exchange Commission (SEC) — Investor.gov',
    url: 'https://www.investor.gov/',
  },
  {
    label: 'Federal Reserve Bank of St. Louis (FRED) — economic data series',
    url: 'https://fred.stlouisfed.org/',
  },
  {
    label: 'Bureau of Labor Statistics — CPI calculator and data tables',
    url: 'https://www.bls.gov/data/',
  },
];
---

<Base
  title="Sources"
  description="Every primary source this site relies on for its figures and its methods, and why each one is here."
  path="/sources/"
>
  <div class="container">
    <div class="page-head">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Sources</span>
      </nav>
      <h1>Sources</h1>
      <p class="page-head__lede">
        Every figure on this site comes from one of the organisations below,
        or from arithmetic the site shows in full. Nothing is quoted from a
        blog post, a summary or a secondary retelling.
      </p>
    </div>

    <div class="prose">
      <h2>Why a source list exists</h2>
      <p>
        A number without a source is an assertion. These pages are written for
        people who want to check the arithmetic themselves, which only works if
        the original data is one click away. Each guide therefore carries its
        own list of sources, and this page is the index of all of them.
      </p>
      <p>
        The rule the site follows is narrow on purpose: government agencies,
        the securities regulator, the central bank and the mortgage GSEs. Where
        a figure comes from a commercial survey, the page says so and names
        the survey.
      </p>

      <h2>How sources are used</h2>
      <ul>
        <li>
          <strong>Methods and formulas</strong> come from the agency that
          publishes the method. The amortization formula is set out in the
          CFPB's own guidance; the compounding frequency rules come from the
          SEC's glossary; the tax thresholds come from the IRS annual
          inflation adjustment.
        </li>
        <li>
          <strong>Published statistics</strong> come from the statistical
          agency that produced them, with the date the figure was read.
        </li>
        <li>
          <strong>Market rates</strong> come from the survey that publishes
          them, and they are dated on the page, because a rate from a
          different month is a different number.
        </li>
      </ul>
    </div>

    <ol class="sources" style="margin-top: var(--space-10);">
      {
        sources.map((source, index) => (
          <li>
            <span class="sources__index">[{index + 1}]</span>
            <a href={source.url} rel="nofollow noopener" target="_blank">
              {source.label}
            </a>
          </li>
        ))
      }
    </ol>

    <AdSlot placement="footer" />
  </div>
</Base>
