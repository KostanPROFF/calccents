# Files in /_astro/ carry a content hash in their name, so a changed file gets
# a new URL and an old URL never changes. They can be kept for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The plain files written for AI systems and feed readers. They hold text in
# every language the site publishes, so the charset is stated rather than
# left to a guess.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/.well-known/ai.txt
  Content-Type: text/plain; charset=utf-8
/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
/*/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
